#
# The recording pipeline: archive, sanity, process, publish, notify. It runs
# through a wrapper entrypoint for a Ruby incompatibility -- see
# overrides/recordings-entrypoint.sh.
#
# The last stage posts a recording-ready callback to Greenlight on the site's
# public name, so it needs the same certificate treatment as Greenlight. Without
# it the callback is refused and a recording publishes correctly yet never appears
# in any room's library.
#

[Unit]
Description=Podman recordings-app.service
BindsTo=bigbluebutton.service
After=bigbluebutton.service redis-app.service bbb-pads-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
EnvironmentFile=-%S/state/passwords.env
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/recordings-app.pid %t/recordings-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/recordings-app.pid \
    --cidfile %t/recordings-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/bigbluebutton.pod-id --replace -d --name recordings-app \
    --env-file=%S/state/passwords.env \
    --env=DOMAIN=${TRAEFIK_HOST} \
    --volume bigbluebutton:/var/bigbluebutton:z \
    --volume freeswitch-meetings:/var/freeswitch/meetings:z \
    --volume mediasoup:/var/mediasoup:z \
    --volume bbb-webrtc-recorder:/var/lib/bbb-webrtc-recorder:z \
    --volume %S/state/overrides/recordings-entrypoint.sh:/recordings-entrypoint.sh:ro,z \
    --volume %S/state/overrides/internal.crt:/usr/local/share/ca-certificates/bigbluebutton-internal.crt:ro,z \
    --tmpfs /var/log/bigbluebutton \
    --tmpfs /tmp \
    --entrypoint=/recordings-entrypoint.sh \
    ${BBB_DOCKER_RECORDINGS_IMAGE}

ExecStop=/usr/bin/podman stop --ignore --cidfile %t/recordings-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/recordings-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/recordings-app.pid
Type=forking

[Install]
WantedBy=default.target
