#
# The interval upstream used in its `periodic` container, without the container.
#

[Unit]
Description=BigBlueButton periodic maintenance timer

[Timer]
# Let the stack settle rather than firing into a half-started pod.
OnBootSec=15min
OnUnitActiveSec=30min
# Recover a run missed while the node was down.
Persistent=true
Unit=bigbluebutton-periodic.service

[Install]
WantedBy=timers.target
