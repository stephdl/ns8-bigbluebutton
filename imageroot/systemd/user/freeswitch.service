#
# FreeSWITCH audio mixer. HOST network namespace, where upstream uses the compose
# bridge: it exchanges RTP with webrtc-sfu on every conference leg, and webrtc-sfu
# cannot leave the host. In the pod, every audio packet would cross rootlessport
# in userspace instead of 127.0.0.1.
#
# Ports: ESL 8021 and SIP-over-WebSocket 5066 keep their defaults, both below the
# 20000-45000 allocator span so nothing else is handed them; fsesl-akka reaches
# ESL from the pod through 10.0.2.2. The RTP range comes from the allocator
# because FreeSWITCH's 16384-24576 default overlaps that span. The external-dialin
# profile is deleted by the patched entrypoint -- 5060 would collide with
# ns8-nethvoice-proxy.
#
# Capabilities are trimmed against upstream: NET_ADMIN and NET_RAW served only an
# iptables block the patched entrypoint drops, and NET_BROADCAST nothing at all.
# The rest are best-effort anyway -- a capability inside a rootless user namespace
# does not lift that namespace's rlimits.
#

[Unit]
Description=Podman freeswitch.service
After=bigbluebutton.service
Wants=bigbluebutton.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
EnvironmentFile=-%S/state/passwords.env
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/freeswitch.pid %t/freeswitch.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/freeswitch.pid \
    --cidfile %t/freeswitch.ctr-id --cgroups=no-conmon \
    --replace -d --name freeswitch \
    --network=host \
    --env-file=%S/state/passwords.env \
    --env=DOMAIN=${TRAEFIK_HOST} \
    --env=EXTERNAL_IPv4=${PUBLIC_IP} \
    --env=SOUNDS_LANGUAGE=${SOUNDS_LANGUAGE} \
    --env=DISABLE_SOUND_MUTED=${DISABLE_SOUND_MUTED} \
    --env=DISABLE_SOUND_ALONE=${DISABLE_SOUND_ALONE} \
    --env=FS_RTP_MIN_PORT=${FS_RTP_MIN_PORT} \
    --env=FS_RTP_MAX_PORT=${FS_RTP_MAX_PORT} \
    --cap-add=IPC_LOCK \
    --cap-add=SYS_NICE \
    --cap-add=SYS_RESOURCE \
    --volume freeswitch-meetings:/var/freeswitch/meetings:z \
    --volume %S/state/overrides/freeswitch-entrypoint.sh:/entrypoint.sh:ro,z \
    ${BBB_DOCKER_FREESWITCH_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/freeswitch.ctr-id -t 3
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/freeswitch.ctr-id
SyslogIdentifier=%u
PIDFile=%t/freeswitch.pid
Type=forking

[Install]
WantedBy=default.target
