#
# FreeSWITCH audio mixer. Runs in the HOST network namespace.
#
# Upstream puts it on the compose bridge, not on the host. Here it has to be on
# the host for a different reason: it exchanges RTP with webrtc-sfu for every
# conference audio leg, and webrtc-sfu cannot leave the host namespace. With
# FreeSWITCH in the pod that traffic would be published port-by-port and every
# audio packet would cross rootlessport in userspace. Both endpoints on the host
# talk over 127.0.0.1 directly.
#
# Port situation on the host:
#   - ESL 8021 and SIP-over-WebSocket 5066 keep their defaults. Both sit below
#     20000, outside the NS8 allocator span, so nothing else is handed them.
#     fsesl-akka, which stays in the pod, reaches ESL through 10.0.2.2.
#   - The RTP range comes from the allocator. FreeSWITCH's 16384-24576 default
#     would overlap the 20000-45000 span and collide with other modules.
#   - The external-dialin profile, which binds 5060, is deleted by the patched
#     entrypoint. SIP dial-in is out of scope, and 5060 would collide with
#     ns8-nethvoice-proxy on the same node.
#
# Capabilities differ from bigbluebutton/docker on purpose. Upstream requests
# IPC_LOCK, NET_ADMIN, NET_RAW, NET_BROADCAST, SYS_NICE and SYS_RESOURCE.
# NET_ADMIN and NET_RAW exist only for the iptables block at the top of the
# upstream entrypoint, which the patched entrypoint drops; NET_BROADCAST has no
# exercising code. The three that remain are best-effort: a capability held
# inside a rootless user namespace does not let the process exceed that
# namespace's own rlimits, so FreeSWITCH degrades to normal scheduling priority.
#

[Unit]
Description=Podman freeswitch.service
After=bigbluebutton.service
Wants=bigbluebutton.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
EnvironmentFile=-%S/state/passwords.env
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/freeswitch.pid %t/freeswitch.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/freeswitch.pid \
    --cidfile %t/freeswitch.ctr-id --cgroups=no-conmon \
    --replace -d --name freeswitch \
    --network=host \
    --env-file=%S/state/passwords.env \
    --env=DOMAIN=${TRAEFIK_HOST} \
    --env=EXTERNAL_IPv4=${PUBLIC_IP} \
    --env=SOUNDS_LANGUAGE=${SOUNDS_LANGUAGE} \
    --env=DISABLE_SOUND_MUTED=${DISABLE_SOUND_MUTED} \
    --env=DISABLE_SOUND_ALONE=${DISABLE_SOUND_ALONE} \
    --env=FS_RTP_MIN_PORT=${FS_RTP_MIN_PORT} \
    --env=FS_RTP_MAX_PORT=${FS_RTP_MAX_PORT} \
    --cap-add=IPC_LOCK \
    --cap-add=SYS_NICE \
    --cap-add=SYS_RESOURCE \
    --volume freeswitch-meetings:/var/freeswitch/meetings:z \
    --volume %S/state/overrides/freeswitch-entrypoint.sh:/entrypoint.sh:ro,z \
    ${BBB_DOCKER_FREESWITCH_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/freeswitch.ctr-id -t 3
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/freeswitch.ctr-id
SyslogIdentifier=%u
PIDFile=%t/freeswitch.pid
Type=forking

[Install]
WantedBy=default.target
