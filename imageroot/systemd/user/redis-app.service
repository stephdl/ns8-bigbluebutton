#
# Not the node's Redis, which already owns 127.0.0.1:6379. This one keeps 6379
# inside the pod and is published on ${REDIS_PORT} for the host-network containers.
#

[Unit]
Description=Podman redis-app.service
BindsTo=bigbluebutton.service
After=bigbluebutton.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=90
ExecStartPre=/bin/rm -f %t/redis-app.pid %t/redis-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/redis-app.pid \
    --cidfile %t/redis-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/bigbluebutton.pod-id --replace -d --name redis-app \
    --volume redis-data:/data:Z \
    ${REDIS_IMAGE}
ExecStartPost=/usr/bin/bash -c "while ! podman exec redis-app redis-cli ping >/dev/null 2>&1; do sleep 1; done"
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/redis-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/redis-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/redis-app.pid
Type=forking

[Install]
WantedBy=default.target
