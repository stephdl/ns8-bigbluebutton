#
# Greenlight, the BigBlueButton front end.
#
# Note what this implies: Greenlight holds user accounts, so identity lives in
# this module rather than being kept out of it. Participants are no longer
# pseudonymous by construction; if that property is needed, it has to come from
# how Greenlight is configured or from a different front end.
#
# Its database URL carries the PostgreSQL password, so it is rendered into
# state/overrides/greenlight.env at configure time rather than passed on the
# podman command line where ps would show it.
#
# DOMAIN below is what makes the API reachable. Greenlight must call it on the
# public name, since that same value becomes the join URL handed to the browser,
# and Ruby then validates the certificate answering for that name. The entrypoint
# appends the name to /etc/hosts pointing at 127.0.0.1, so the call goes to this
# pod's own nginx, which serves a certificate configure-module issued for
# exactly this name and mounted below into the CA store. Browsers are
# unaffected: they resolve the name normally and still reach Traefik.
#
# The entrypoint appends rather than podman mounting a replacement file, because
# the generated one carries the pod's --add-host names and losing them sends the
# resolver to DNS. It is scoped to this container rather than set pod-wide
# because apps-akka and bbb-web call the same host and validate it against a JVM
# trust store this module does not manage.
#

[Unit]
Description=Podman greenlight-app.service
BindsTo=bigbluebutton.service
After=bigbluebutton.service postgres-app.service redis-app.service bbb-web-app.service nginx-app.service
# Greenlight's bin/start migrates but never seeds, so a fresh instance has no
# administrator and its admin panel is hidden from everyone. The bootstrap
# account is created by a separate oneshot, which can wait for the migration to
# finish; an ExecStartPost here would run while it is still going.
Wants=greenlight-seed-admin.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
EnvironmentFile=-%S/state/passwords.env
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/greenlight-app.pid %t/greenlight-app.ctr-id
# Refresh the SMTP relay settings from the cluster before every start, so a
# smarthost change is picked up without reconfiguring the module.
ExecStartPre=runagent discover-smarthost
# POSTGRES_MULTIPLE_DATABASES only runs on a fresh data directory, so an
# instance created before Greenlight existed has no greenlight database.
# Create it if missing; "already exists" is the normal outcome.
ExecStartPre=-/usr/bin/podman exec postgres-app psql -U postgres -c "CREATE DATABASE greenlight"
ExecStart=/usr/bin/podman run --conmon-pidfile %t/greenlight-app.pid \
    --cidfile %t/greenlight-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/bigbluebutton.pod-id --replace -d --name greenlight-app \
    --env=DOMAIN=${TRAEFIK_HOST} \
    --env-file=%S/state/overrides/greenlight.env \
    --env-file=%S/state/smarthost.env \
    --volume greenlight:/usr/src/app/storage:z \
    --volume %S/state/overrides/greenlight-entrypoint.sh:/greenlight-entrypoint.sh:ro,z \
    --volume %S/state/overrides/internal.crt:/usr/local/share/ca-certificates/bigbluebutton-internal.crt:ro,z \
    --entrypoint=/greenlight-entrypoint.sh \
    ${GREENLIGHT_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/greenlight-app.ctr-id -t 3
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/greenlight-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/greenlight-app.pid
Type=forking

[Install]
WantedBy=default.target
