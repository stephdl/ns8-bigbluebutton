#
# mediasoup SFU. HOST network namespace, not the pod: WebRTC media must bind the
# node's real addresses, and slirp4netns forwarding would cost latency and CPU on
# every RTP packet.
#
# Security consequences, both from upstream (docker-compose.tmpl.yml:255-259) and
# both recorded in docs/packaging-analysis.md section 7: this container reaches
# everything on the node's loopback, including the cluster Redis on 6379, and
# seccomp=unconfined drops syscall filtering on the most attacker-reachable
# component in the stack. It is unconfined for io_uring, which the default podman
# seccomp profile blocks.
#
# No memlock limit is set and none is needed: a rootless process cannot raise its
# hard limit anyway, and mediasoup disables zero copy on ENOMEM rather than
# failing. To turn zero copy off deterministically, use mediasoup's
# disableLiburing option in the mounted config, not a limit here.
#

[Unit]
Description=Podman webrtc-sfu.service
After=bigbluebutton.service freeswitch.service redis-app.service
Wants=bigbluebutton.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
EnvironmentFile=-%S/state/passwords.env
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/webrtc-sfu.pid %t/webrtc-sfu.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/webrtc-sfu.pid \
    --cidfile %t/webrtc-sfu.ctr-id --cgroups=no-conmon \
    --replace -d --name webrtc-sfu \
    --network=host \
    --security-opt seccomp=unconfined \
    --env-file=%S/state/passwords.env \
    --env=MS_WEBRTC_LISTEN_IPS=${MS_WEBRTC_LISTEN_IPS} \
    --volume mediasoup:/var/mediasoup:z \
    --volume %S/state/overrides/webrtc-sfu-config.yaml:/etc/bigbluebutton/bbb-webrtc-sfu/production.yml:ro,z \
    --tmpfs /var/log/bbb-webrtc-sfu \
    ${BBB_DOCKER_WEBRTC_SFU_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/webrtc-sfu.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/webrtc-sfu.ctr-id
SyslogIdentifier=%u
PIDFile=%t/webrtc-sfu.pid
Type=forking

[Install]
WantedBy=default.target
