#
# Pod master unit. freeswitch, webrtc-sfu and bbb-webrtc-recorder are NOT in it:
# they run in the host network namespace. See docs/packaging-analysis.md.
#
# The --add-host entries point every peer at 127.0.0.1, which is BigBlueButton's
# native addressing -- the 10.7.7.x split upstream exists only to fit compose.
#

[Unit]
Description=Podman bigbluebutton.service
Requires=postgres-app.service redis-app.service bbb-web-app.service \
    nginx-app.service etherpad-app.service \
    bbb-pads-app.service bbb-export-annotations-app.service \
    apps-akka-app.service fsesl-akka-app.service \
    bbb-graphql-server-app.service bbb-graphql-actions-app.service \
    bbb-graphql-middleware-app.service greenlight-app.service
Before=postgres-app.service redis-app.service bbb-web-app.service \
    nginx-app.service etherpad-app.service \
    bbb-pads-app.service bbb-export-annotations-app.service \
    apps-akka-app.service fsesl-akka-app.service \
    bbb-graphql-server-app.service bbb-graphql-actions-app.service \
    bbb-graphql-middleware-app.service recordings-app.service greenlight-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
Restart=always
TimeoutStopSec=90
ExecStartPre=/bin/rm -f %t/bigbluebutton.pid %t/bigbluebutton.pod-id
# Render state/overrides/ before anything mounts from it: podman answers a missing
# bind mount source by creating a directory, and an entrypoint mounted that way
# crash-loops. Every container is After= this unit, so do not drop that ordering.
ExecStartPre=runagent render-overrides
ExecStartPre=/usr/bin/podman pod create \
    --infra-conmon-pidfile %t/bigbluebutton.pid \
    --pod-id-file %t/bigbluebutton.pod-id \
    --name bigbluebutton \
    --publish 127.0.0.1:${NGINX_PORT}:48087 \
    --publish 127.0.0.1:${REDIS_PORT}:6379 \
    --network=slirp4netns:allow_host_loopback=true \
    --add-host=postgres:127.0.0.1 \
    --add-host=redis:127.0.0.1 \
    --add-host=bbb-web:127.0.0.1 \
    --add-host=etherpad:127.0.0.1 \
    --add-host=bbb-pads:127.0.0.1 \
    --add-host=apps-akka:127.0.0.1 \
    --add-host=bbb-graphql-server:127.0.0.1 \
    --add-host=bbb-graphql-actions:127.0.0.1 \
    --add-host=bbb-graphql-middleware:127.0.0.1 \
    --add-host=nginx:127.0.0.1 \
    --add-host=greenlight:127.0.0.1 \
    --add-host=freeswitch:10.0.2.2 \
    --add-host=webrtc-sfu:10.0.2.2 \
    --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/bigbluebutton.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/bigbluebutton.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/bigbluebutton.pod-id
PIDFile=%t/bigbluebutton.pid
SyslogIdentifier=%u
Type=forking

[Install]
WantedBy=default.target
