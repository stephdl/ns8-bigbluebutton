#
# HOST network namespace for the same reason as webrtc-sfu: it is a WebRTC endpoint.
#
# The mkdir replaces the image's chown-and-drop command and is what makes webcam
# recording work: podman creates a missing mount point owned by root, so whichever
# of this container and recordings-app started last decided the owner, and losing
# that race produced sound over a blank picture.
#

[Unit]
Description=Podman bbb-webrtc-recorder.service
After=bigbluebutton.service redis-app.service
Wants=bigbluebutton.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
Restart=always
TimeoutStopSec=90
ExecStartPre=/bin/rm -f %t/bbb-webrtc-recorder.pid %t/bbb-webrtc-recorder.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/bbb-webrtc-recorder.pid \
    --cidfile %t/bbb-webrtc-recorder.ctr-id --cgroups=no-conmon \
    --replace -d --name bbb-webrtc-recorder \
    --network=host \
    --env=BBBRECORDER_PUBSUB_ADAPTERS_REDIS_ADDRESS=127.0.0.1:${REDIS_PORT} \
    --volume bbb-webrtc-recorder:/var/lib/bbb-webrtc-recorder:z \
    --entrypoint=/bin/sh \
    ${BBB_DOCKER_WEBRTC_RECORDER_IMAGE} \
    -c 'mkdir -p /var/lib/bbb-webrtc-recorder/recordings && chown -R bigbluebutton:bigbluebutton /var/lib/bbb-webrtc-recorder && exec gosu bigbluebutton /usr/bin/bbb-webrtc-recorder'
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/bbb-webrtc-recorder.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/bbb-webrtc-recorder.ctr-id
SyslogIdentifier=%u
PIDFile=%t/bbb-webrtc-recorder.pid
Type=forking

[Install]
WantedBy=default.target
