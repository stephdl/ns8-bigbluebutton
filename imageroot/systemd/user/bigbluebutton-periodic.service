#
# Triggered by bigbluebutton-periodic.timer. Not enabled on its own.
#
# runagent puts the script in the module environment, as for the other helpers.
#

[Unit]
Description=BigBlueButton periodic maintenance
After=bigbluebutton.service

[Service]
Type=oneshot
ExecStart=runagent bigbluebutton-periodic
SyslogIdentifier=%u
