#
# Built-in TURN server, enabled only when turn_enabled is true. Host network,
# like webrtc-sfu: the relay must send from the node's real address.
#
# No render-overrides here: configure-module and bigbluebutton.service do it,
# and a re-render at each restart would rewrite files live containers read.
#
# state/eturnal.env holds only what eturnal needs, not all of passwords.env.
# STUN_SERVICE=false: no public STUN lookup, the relay address is configured.
# --image-volume=ignore: avoids a new anonymous volume at every restart.
# Erlang listens on the fixed 127.0.0.1:3470, fine with max-per-node=1.
#

[Unit]
Description=Podman eturnal.service
After=bigbluebutton.service
Wants=bigbluebutton.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=30
ExecStartPre=/bin/rm -f %t/eturnal.pid %t/eturnal.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/eturnal.pid \
    --cidfile %t/eturnal.ctr-id --cgroups=no-conmon \
    --replace -d --name eturnal \
    --network=host \
    --read-only \
    --tmpfs /tmp \
    --tmpfs /opt/eturnal/run:mode=1777 \
    --image-volume=ignore \
    --cap-drop=ALL \
    --security-opt no-new-privileges \
    --no-healthcheck \
    --env-file=%S/state/eturnal.env \
    --env=STUN_SERVICE=false \
    --volume %S/state/overrides/eturnal.yml:/etc/eturnal.yml:ro,z \
    --volume %S/state/overrides/eturnal-entrypoint.sh:/eturnal-entrypoint.sh:ro,z \
    --entrypoint='["/sbin/tini","--","/eturnal-entrypoint.sh"]' \
    ${ETURNAL_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/eturnal.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/eturnal.ctr-id
SyslogIdentifier=%u
PIDFile=%t/eturnal.pid
Type=forking

[Install]
WantedBy=default.target
