#
# Not an ExecStartPost of greenlight-app: that fires when podman run -d returns,
# while Greenlight is still migrating and the users table does not exist yet.
#
# Pulled in by Wants=, so no [Install] section. Runs on every Greenlight start and
# returns immediately once an administrator exists.
#

[Unit]
Description=Create the Greenlight bootstrap administrator
After=greenlight-app.service

[Service]
Type=oneshot
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
TimeoutStartSec=900
ExecStart=runagent seed-default-admin --wait 600
SyslogIdentifier=%u
