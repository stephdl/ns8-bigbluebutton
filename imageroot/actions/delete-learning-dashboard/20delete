#
# A report has no counterpart in any database, so removing its directory is the
# whole deletion. Recordings are different and go through bbb-record instead.
#

import os
import sys
import json
import subprocess

import agent

data = json.load(sys.stdin)

volume = subprocess.run(
    ["podman", "volume", "inspect", "bigbluebutton", "--format", "{{.Mountpoint}}"],
    capture_output=True, text=True,
).stdout.strip()

agent.assert_exp(bool(volume), "cannot resolve the bigbluebutton volume")

root = os.path.realpath(os.path.join(volume, "learning-dashboard"))
meeting_dir = os.path.join(root, data["meeting_id"])
report_dir = os.path.join(meeting_dir, data["token"])

# Second lock after the schema patterns, because what follows is an rm -rf.
agent.assert_exp(
    os.path.realpath(report_dir).startswith(root + os.sep),
    "the report path escapes the learning-dashboard directory",
)

# The volume belongs to the container's rootless user namespace, not the host UID
# this action runs as: an rm here would get "Permission denied". podman unshare
# re-execs it in that namespace, as steps 3 and 4 of bin/bigbluebutton-periodic do.
agent.run_helper("podman", "unshare", "rm", "-rf", report_dir).check_returncode()

# Retention prunes learning-dashboard/<meeting_id> by mtime, and only when it is
# enabled, so nothing else would ever collect the emptied parent.
subprocess.run(["podman", "unshare", "rmdir", meeting_dir],
               capture_output=True, text=True)
