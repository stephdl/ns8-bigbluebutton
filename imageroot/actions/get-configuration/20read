#
# Mirrors configure-module's input, so the UI round-trips without losing settings.
#

import os
import subprocess
import sys
import json
import agent

config = {}

config["host"] = os.getenv("TRAEFIK_HOST", "")
config["lets_encrypt"] = agent.get_route(os.environ["MODULE_ID"]).get("lets_encrypt", False)

config["public_address"] = os.getenv("PUBLIC_IP", "") or os.getenv("DETECTED_PUBLIC_IP", "")
config["private_address"] = os.getenv("PRIVATE_IP", "") or os.getenv("DETECTED_PRIVATE_IP", "")
config["stun_server"] = os.getenv("STUN_SERVER", "")
config["turn_ext_server"] = os.getenv("TURN_EXT_SERVER", "")

# The secret itself stays out: a task output is stored in Redis.
secrets_path = os.path.join(os.environ["AGENT_STATE_DIR"], "passwords.env")
stored = agent.read_envfile(secrets_path) if os.path.exists(secrets_path) else {}
config["turn_ext_secret_set"] = bool(stored.get("TURN_EXT_SECRET", ""))

config["enable_recording"] = os.getenv("ENABLE_RECORDING") == "true"
config["remove_old_recording"] = os.getenv("REMOVE_OLD_RECORDING") == "true"
config["recording_max_age_days"] = int(os.getenv("RECORDING_MAX_AGE_DAYS", "14"))
config["enable_learning_dashboard"] = os.getenv("ENABLE_LEARNING_DASHBOARD", "true") == "true"
config["sounds_language"] = os.getenv("SOUNDS_LANGUAGE", "en-us-callie")
config["disable_sound_muted"] = os.getenv("DISABLE_SOUND_MUTED") == "true"
config["disable_sound_alone"] = os.getenv("DISABLE_SOUND_ALONE") == "true"
config["welcome_message"] = os.getenv("WELCOME_MESSAGE", "")
config["welcome_footer"] = os.getenv("WELCOME_FOOTER", "")

# Live, not cached: the password is changed in Greenlight, which cannot tell us.
try:
    probe = subprocess.run(["check-default-admin"], capture_output=True,
                           text=True, timeout=30)
    config["default_admin_password_in_use"] = probe.stdout.strip() == "true"
except Exception:
    config["default_admin_password_in_use"] = False

# Read-only. False when Traefik serves a certificate for another name.
config["certificate_matches_host"] = os.getenv("CERTIFICATE_MATCHES_HOST", "true") == "true"

# Read-only. The range that must be reachable from the internet.
config["mediasoup_port_range"] = "{}-{}".format(
    os.getenv("MEDIASOUP_MIN_PORT", ""), os.getenv("MEDIASOUP_MAX_PORT", "")
)

json.dump(config, fp=sys.stdout)
