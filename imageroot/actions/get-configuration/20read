#
# Read configuration. Mirrors configure-module's input: every field it accepts
# is returned here, so the UI round-trips without losing settings.
#

import os
import subprocess
import sys
import json
import agent

config = {}

config["host"] = os.getenv("TRAEFIK_HOST", "")
config["lets_encrypt"] = agent.get_route(os.environ["MODULE_ID"]).get("lets_encrypt", False)

config["public_address"] = os.getenv("PUBLIC_IP", "") or os.getenv("DETECTED_PUBLIC_IP", "")
config["private_address"] = os.getenv("PRIVATE_IP", "") or os.getenv("DETECTED_PRIVATE_IP", "")
config["stun_server"] = os.getenv("STUN_SERVER", "")
config["turn_ext_server"] = os.getenv("TURN_EXT_SERVER", "")

config["enable_recording"] = os.getenv("ENABLE_RECORDING") == "true"
config["remove_old_recording"] = os.getenv("REMOVE_OLD_RECORDING") == "true"
config["recording_max_age_days"] = int(os.getenv("RECORDING_MAX_AGE_DAYS", "14"))
config["enable_learning_dashboard"] = os.getenv("ENABLE_LEARNING_DASHBOARD", "true") == "true"
config["sounds_language"] = os.getenv("SOUNDS_LANGUAGE", "en-us-callie")
config["disable_sound_muted"] = os.getenv("DISABLE_SOUND_MUTED") == "true"
config["disable_sound_alone"] = os.getenv("DISABLE_SOUND_ALONE") == "true"
config["welcome_message"] = os.getenv("WELCOME_MESSAGE", "")
config["welcome_footer"] = os.getenv("WELCOME_FOOTER", "")

# Checked live rather than cached: the administrator changes this password in
# Greenlight, which has no way to tell the module, and a warning that lingers
# after it has been dealt with teaches people to ignore warnings.
#
# The probe waits, because during a configure-module the containers it needs are
# absent for over a minute and it used to answer "false" for the whole window --
# so opening this page while the stack restarted said the shipped password had
# been dealt with, and only a reload told the truth.
#
# The budget is bounded rather than long enough to cover a full restart: this
# action is what the settings page opens on, and a page that hangs for a minute
# is its own defect. Past the budget the answer is unknown, and unknown warns.
# A password that ships with the module is too serious to hide on a maybe; the
# warning clears itself on the next load, once the check can run.
try:
    probe = subprocess.run(["check-default-admin", "--wait", "25"],
                           capture_output=True, text=True, timeout=40)
    if probe.returncode == 0:
        config["default_admin_password_in_use"] = probe.stdout.strip() == "true"
    else:
        config["default_admin_password_in_use"] = True
        print(agent.SD_WARNING + "could not check the administrator password, "
              "reporting it as unchanged: " + probe.stderr.strip(), file=sys.stderr)
except Exception as ex:
    config["default_admin_password_in_use"] = True
    print(agent.SD_WARNING + f"the administrator password check failed: {ex}",
          file=sys.stderr)

# Read-only. False means Traefik serves a certificate issued for some other
# name, which breaks Greenlight and denies the browser microphone and camera.
config["certificate_matches_host"] = os.getenv("CERTIFICATE_MATCHES_HOST", "true") == "true"

# Read-only, for the UI to show what the allocator handed out. This is the
# range that must be reachable from the internet.
config["mediasoup_port_range"] = "{}-{}".format(
    os.getenv("MEDIASOUP_MIN_PORT", ""), os.getenv("MEDIASOUP_MAX_PORT", "")
)

json.dump(config, fp=sys.stdout)
