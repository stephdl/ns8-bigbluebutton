{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get bigbluebutton settings",
    "$id": "http://nethserver.org/json-schema/task/output/bigbluebutton/get-configuration",
    "description": "Get BigBlueButton settings",
    "examples": [
        {
            "host": "bbb.domain.org",
            "lets_encrypt": true,
            "public_address": "203.0.113.10",
            "private_address": "192.168.1.10",
            "stun_server": "",
            "turn_ext_server": "",
            "turn_ext_secret_set": false,
            "enable_recording": false,
            "enable_learning_dashboard": true,
            "sounds_language": "en-us-callie",
            "disable_sound_muted": false,
            "disable_sound_alone": false,
            "welcome_message": "",
            "welcome_footer": "",
            "mediasoup_port_range": "20000-28191",
            "remove_old_recording": false,
            "recording_max_age_days": 14,
            "certificate_matches_host": true,
            "default_admin_password_in_use": false
        }
    ],
    "type": "object",
    "required": [
        "host",
        "lets_encrypt",
        "public_address",
        "private_address",
        "stun_server",
        "turn_ext_server",
        "turn_ext_secret_set",
        "enable_recording",
        "enable_learning_dashboard",
        "sounds_language",
        "disable_sound_muted",
        "disable_sound_alone",
        "welcome_message",
        "welcome_footer",
        "mediasoup_port_range",
        "remove_old_recording",
        "recording_max_age_days",
        "certificate_matches_host",
        "default_admin_password_in_use"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name for the application, like 'bbb.domain.org'",
            "format": "idn-hostname"
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "public_address": {
            "type": "string",
            "title": "Public IP address",
            "description": "Address announced by mediasoup to WebRTC clients"
        },
        "private_address": {
            "type": "string",
            "title": "LAN IP address",
            "description": "Additional address advertised to clients on the local network"
        },
        "stun_server": {
            "type": "string",
            "title": "STUN server"
        },
        "turn_ext_server": {
            "type": "string",
            "title": "External TURN server"
        },
        "turn_ext_secret_set": {
            "type": "boolean",
            "title": "A TURN shared secret is stored",
            "description": "Read-only. The secret itself is never returned: it would land in the task output, which lives in Redis."
        },
        "enable_recording": {
            "type": "boolean",
            "title": "Enable recording"
        },
        "enable_learning_dashboard": {
            "type": "boolean",
            "title": "Enable learning dashboard"
        },
        "sounds_language": {
            "type": "string",
            "title": "Sound announcements language"
        },
        "disable_sound_muted": {
            "type": "boolean",
            "title": "Disable muted announcement"
        },
        "disable_sound_alone": {
            "type": "boolean",
            "title": "Disable alone announcement"
        },
        "welcome_message": {
            "type": "string",
            "title": "Welcome message"
        },
        "welcome_footer": {
            "type": "string",
            "title": "Welcome footer"
        },
        "mediasoup_port_range": {
            "type": "string",
            "title": "Public UDP port range",
            "description": "Read-only. The mediasoup RTC range allocated by the node, which must be reachable from the internet."
        },
        "remove_old_recording": {
            "type": "boolean",
            "title": "Delete old recordings"
        },
        "recording_max_age_days": {
            "type": "integer",
            "title": "Recording retention (days)"
        },
        "certificate_matches_host": {
            "type": "boolean",
            "title": "Certificate matches the hostname",
            "description": "Read-only. False when Traefik serves a certificate issued for another name."
        },
        "default_admin_password_in_use": {
            "type": "boolean",
            "title": "Default administrator password still in use",
            "description": "Read-only. True while admin@admin.com still has the password Greenlight publishes in its source."
        }
    }
}
