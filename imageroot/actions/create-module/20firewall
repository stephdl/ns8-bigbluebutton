#
# The build-images.sh label only reserves the ports against the node registry;
# opening them in the firewall is this call. Only the mediasoup half is public,
# and no TCP port at all: Traefik owns 443.
#

import os
import agent

# agent.set_env() does not touch os.environ, and each step is its own process:
# read state/environment back.
env = agent.read_envfile(os.path.join(os.environ["AGENT_STATE_DIR"], "environment"))

agent.assert_exp(agent.add_public_service(os.environ["MODULE_ID"], [
    f"{env['MEDIASOUP_MIN_PORT']}-{env['MEDIASOUP_MAX_PORT']}/udp",
]))
