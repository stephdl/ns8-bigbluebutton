#
# Pre-fill the addresses mediasoup needs, so the admin does not have to look
# them up. Never fatal: a node that cannot be probed still installs, and
# configure-module refuses until the fields are filled in by hand.
#

exec 1>&2 # Redirect any output to the journal

detect-addresses >/dev/null || true
