#
# Generate the BigBlueButton secrets.
#
# These MUST NOT go through agent.set_env(): that writes to Redis in plain text,
# readable by every module on the node. SHARED_SECRET would let any co-installed
# module forge BigBlueButton API calls, and FSESL_PASSWORD would hand over the
# FreeSWITCH command socket.
#
# state/passwords.env is listed in etc/state-include.conf, so Restic backs it up
# and restores it: no restore-side code is needed.
#

import os
import secrets
import sys

state_dir = os.environ["AGENT_STATE_DIR"]
path = os.path.join(state_dir, "passwords.env")

if os.path.exists(path):
    print("passwords.env already exists, leaving it untouched", file=sys.stderr)
    sys.exit(0)

secrets_map = {
    # BigBlueButton API shared secret: signs every API call
    "SHARED_SECRET": secrets.token_hex(32),
    # Etherpad admin API key, shared with bbb-pads
    "ETHERPAD_API_KEY": secrets.token_hex(32),
    # PostgreSQL superuser password. The variable name is what the postgres
    # image expects; apps-akka and bbb-graphql-server read the same value.
    "POSTGRES_PASSWORD": secrets.token_urlsafe(24),
    # FreeSWITCH event socket password. Read by freeswitch, fsesl-akka and
    # webrtc-sfu, which is why it is also injected into the host-network unit.
    "FSESL_PASSWORD": secrets.token_urlsafe(24),
    "ESL_PASSWORD": None,  # filled below: same value, different variable name
    # Hasura admin secret. Upstream ships the literal TODO_CHANGE_ME
    # (docker-compose.tmpl.yml:325).
    "HASURA_GRAPHQL_ADMIN_SECRET": secrets.token_urlsafe(24),
}

# freeswitch and webrtc-sfu read ESL_PASSWORD, fsesl-akka reads FSESL_PASSWORD.
# Same secret under both names so a single env-file serves every consumer.
secrets_map["ESL_PASSWORD"] = secrets_map["FSESL_PASSWORD"]

# Opened with mode 0600 from the start: never briefly world-readable.
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(fd, "w") as fp:
    for key, value in secrets_map.items():
        print(f"{key}={value}", file=fp)

print(f"Generated {len(secrets_map)} secrets in {path}", file=sys.stderr)
