#
# Both sides: Greenlight's recordings row, then the files through bbb-record. The
# order matters and bin/delete-greenlight-recording says why.
#

import sys
import json
import subprocess

import agent

meeting_id = json.load(sys.stdin)["meeting_id"]

# First, so a failure here leaves a recording this module can still list and delete.
agent.run_helper("delete-greenlight-recording", meeting_id).check_returncode()

# The periodic job skips quietly when it is down; here somebody asked for a deletion.
# capture_output: stdout is the task's JSON channel, podman must not write to it.
agent.assert_exp(
    subprocess.run(["podman", "container", "exists", "recordings-app"],
                   capture_output=True).returncode == 0,
    "the recordings container is not running",
)

agent.run_helper("podman", "exec", "recordings-app",
                 "bbb-record", "--delete", meeting_id).check_returncode()
