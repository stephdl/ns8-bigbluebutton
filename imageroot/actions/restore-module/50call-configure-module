#
# Re-run configure-module with the restored settings.
#
# Every field configure-module accepts must be passed. Anything omitted falls
# back to its default and silently reconfigures the module differently from the
# backup: the override files, the Traefik route and the mediasoup announced
# address are all derived here.
#
# The variables come from os.environ because 06copyenv already wrote them to
# state/environment and the agent reloads it between actions.
#

import os
import sys
import agent

config = {
    "host": os.environ["TRAEFIK_HOST"],
    "lets_encrypt": os.environ.get("TRAEFIK_LETS_ENCRYPT", "false") == "true",
    "public_address": os.environ["PUBLIC_IP"],
    "private_address": os.environ.get("PRIVATE_IP", ""),
    "stun_server": os.environ.get("STUN_SERVER", ""),
    "turn_ext_server": os.environ.get("TURN_EXT_SERVER", ""),
    "registration_method": os.environ.get("REGISTRATION_METHOD", "open"),
    "allowed_domains": os.environ.get("ALLOWED_DOMAINS", ""),
    "enable_recording": os.environ.get("ENABLE_RECORDING", "false") == "true",
    "remove_old_recording": os.environ.get("REMOVE_OLD_RECORDING", "false") == "true",
    "recording_max_age_days": int(os.environ.get("RECORDING_MAX_AGE_DAYS", "14")),
    "enable_learning_dashboard": os.environ.get("ENABLE_LEARNING_DASHBOARD", "true") == "true",
    "sounds_language": os.environ.get("SOUNDS_LANGUAGE", "en-us-callie"),
    "disable_sound_muted": os.environ.get("DISABLE_SOUND_MUTED", "false") == "true",
    "disable_sound_alone": os.environ.get("DISABLE_SOUND_ALONE", "false") == "true",
    "welcome_message": os.environ.get("WELCOME_MESSAGE", ""),
    "welcome_footer": os.environ.get("WELCOME_FOOTER", ""),
}

response = agent.tasks.run(
    agent_id="module/" + os.environ["MODULE_ID"],
    action="configure-module",
    data=config,
)

agent.assert_exp(response["exit_code"] == 0, "configure-module failed during restore")
