#
# Replay the two PostgreSQL dumps into a fresh data directory, using an
# ephemeral container. The postgres image entrypoint runs everything in
# /docker-entrypoint-initdb.d on an empty data dir, so the databases are
# created by our initdb script and then loaded here.
#

set -e -o pipefail
exec 1>&2 # Redirect any output to the journal (stderr)

# Nothing to do on a clone: clone-module gets a fresh database and no dumps.
if [ ! -f bbb_graphql.pg_dump ]; then
    echo "No dump found, skipping database restore"
    exit 0
fi

# The password the restored secrets file carries: the data directory is being
# created from scratch here, so it must match what the module will use later.
set -a
. ./passwords.env
set +a

mkdir -vp restore/initdb

# Recreate the databases before loading into them. This one does belong in
# /docker-entrypoint-initdb.d: it only needs the temporary server the image's
# entrypoint runs while initialising an empty data directory.
cp -v "${AGENT_INSTALL_DIR}/overrides/postgres-initdb.sh" restore/initdb/10-create-databases.sh
chmod 755 restore/initdb/10-create-databases.sh

# The restore does not. It used to, and ended with docker_temp_server_stop to
# make the container exit -- a call that only exists as a shell function inside
# the entrypoint, and the entrypoint *executes* an init script that carries the
# exec bit rather than sourcing it. The child shell has no such function, so the
# step died on "docker_temp_server_stop: command not found" after every database
# had already been restored: data in place, action reported failed, cleanup never
# reached. Before the search_path fix it never got that far, which is why the
# call looked harmless.
#
# So the container is started detached and stopped once the restore has run,
# rather than being asked to end itself from inside a hook.
#
# The dump is converted to SQL and piped through psql rather than replayed
# directly, for one substitution. pg_dump emits
#
#     SELECT pg_catalog.set_config('search_path', '', false);
#
# and schema-qualifies everything it writes, which is safe for its own output but
# not for function bodies it merely carries across. BigBlueButton declares
#
#     immutable_lower_unaccent(text) AS SELECT lower(unaccent('unaccent', $1))
#
# with unaccent unqualified, and the user table has ten columns GENERATED ALWAYS
# from it. Creating that table inlines the function, which resolves unaccent
# against the session search_path -- empty -- and fails. The table is never
# created, and every foreign key pointing at it fails in turn: 67 errors, and a
# database missing 22 tables including public.user.
#
# It works in normal operation because Hasura builds the schema with search_path
# at its default. Only a restore hits it. Restoring into public rather than into
# nothing is enough, and leaves the statement's intent intact.
#
# ON_ERROR_STOP because the old form ignored all 67 errors and reported failure
# only from pg_restore's exit code, which is how a database could have come back
# quietly incomplete. psql's standard output is dropped because the dump's own
# set_config and setval calls would otherwise fill the journal with result rows;
# errors go to standard error and are kept.
cat - >restore/20-restore.sh <<'EOS'
#!/bin/bash
# bash, not sh: pipefail. The image's own entrypoint is #!/usr/bin/env bash, so
# it is there.
set -e -o pipefail
for db in bbb_graphql hasura_app greenlight; do
    echo "Restoring ${db}"
    pg_restore --no-owner --no-privileges --file=- "/dumps/${db}.pg_dump" \
        | sed "s/set_config('search_path', '', false)/set_config('search_path', 'public', false)/" \
        | psql -v ON_ERROR_STOP=1 -U postgres -q -d "${db}" >/dev/null
done
EOS
chmod 755 restore/20-restore.sh

podman run \
    --rm --detach \
    --network=none \
    --volume=./restore/initdb:/docker-entrypoint-initdb.d/:Z \
    --volume=./restore/20-restore.sh:/restore.sh:ro,Z \
    --volume=.:/dumps:z \
    --volume=postgres-data:/var/lib/postgresql/data:Z \
    --replace --name=restore_db \
    --env POSTGRES_USER=postgres \
    --env POSTGRES_PASSWORD="${POSTGRES_PASSWORD}" \
    --env POSTGRES_MULTIPLE_DATABASES=bbb_graphql,hasura_app,greenlight \
    --env TZ=UTC \
    "${POSTGRES_IMAGE}" >/dev/null

# TCP is the signal that initialisation is over. While the entrypoint runs
# initdb and the scripts above, its temporary server listens on the Unix socket
# only; 5432 starts answering when it execs the real postgres, which it does
# once every init script has completed. Measured: socket answers from 6s and TCP
# from 15s on a data directory being created, and the database that an init
# script creates appears in the same tick as TCP.
deadline=$(( SECONDS + 180 ))
until podman exec restore_db pg_isready -h 127.0.0.1 -q 2>/dev/null; do
    if ! podman container exists restore_db; then
        echo "the database container stopped while initialising:" 1>&2
        podman logs restore_db 2>&1 | tail -30 1>&2 || true
        exit 1
    fi
    if [ "${SECONDS}" -ge "${deadline}" ]; then
        echo "the database did not finish initialising within 180s" 1>&2
        podman logs restore_db 2>&1 | tail -30 1>&2
        podman stop --time 20 restore_db >/dev/null || true
        exit 1
    fi
    sleep 2
done

# Errors surface here rather than in a container's exit code.
podman exec restore_db /restore.sh

# Shut it down cleanly: this is the same cluster the module's own postgres-app
# will open next, and a fast shutdown leaves it needing crash recovery.
podman stop --time 60 restore_db >/dev/null

# If the restore is successful, clean up
rm -rfv restore/ bbb_graphql.pg_dump hasura_app.pg_dump greenlight.pg_dump
