#
# Replay the two PostgreSQL dumps into a fresh data directory, using an
# ephemeral container. The postgres image entrypoint runs everything in
# /docker-entrypoint-initdb.d on an empty data dir, so the databases are
# created by our initdb script and then loaded here.
#

set -e -o pipefail
exec 1>&2 # Redirect any output to the journal (stderr)

# Nothing to do on a clone: clone-module gets a fresh database and no dumps.
if [ ! -f bbb_graphql.pg_dump ]; then
    echo "No dump found, skipping database restore"
    exit 0
fi

# The password the restored secrets file carries: the data directory is being
# created from scratch here, so it must match what the module will use later.
set -a
. ./passwords.env
set +a

mkdir -vp restore

# Recreate the two databases before loading into them.
cp -v "${AGENT_INSTALL_DIR}/overrides/postgres-initdb.sh" restore/10-create-databases.sh
chmod 755 restore/10-create-databases.sh

# One script per dump. pg_restore reads from a file rather than stdin here,
# because two dumps cannot share a single standard input.
#
# The dump is converted to SQL and piped through psql rather than replayed
# directly, for one substitution. pg_dump emits
#
#     SELECT pg_catalog.set_config('search_path', '', false);
#
# and schema-qualifies everything it writes, which is safe for its own output but
# not for function bodies it merely carries across. BigBlueButton declares
#
#     immutable_lower_unaccent(text) AS SELECT lower(unaccent('unaccent', $1))
#
# with unaccent unqualified, and the user table has ten columns GENERATED ALWAYS
# from it. Creating that table inlines the function, which resolves unaccent
# against the session search_path -- empty -- and fails. The table is never
# created, and every foreign key pointing at it fails in turn: 67 errors, and a
# database missing 22 tables including public.user.
#
# It works in normal operation because Hasura builds the schema with search_path
# at its default. Only a restore hits it. Restoring into public rather than into
# nothing is enough, and leaves the statement's intent intact.
#
# ON_ERROR_STOP because the old form ignored all 67 errors and reported failure
# only from pg_restore's exit code, which is how a database could have come back
# quietly incomplete. psql's standard output is dropped because the dump's own
# set_config and setval calls would otherwise fill the journal with result rows;
# errors go to standard error and are kept.
cat - >restore/20-restore.sh <<'EOS'
set -e -o pipefail
for db in bbb_graphql hasura_app greenlight; do
    echo "Restoring ${db}"
    pg_restore --no-owner --no-privileges --file=- "/dumps/${db}.pg_dump" \
        | sed "s/set_config('search_path', '', false)/set_config('search_path', 'public', false)/" \
        | psql -v ON_ERROR_STOP=1 -U postgres -q -d "${db}" >/dev/null
done
docker_temp_server_stop
EOS
chmod 755 restore/20-restore.sh

podman run \
    --rm \
    --network=none \
    --volume=./restore:/docker-entrypoint-initdb.d/:Z \
    --volume=.:/dumps:z \
    --volume=postgres-data:/var/lib/postgresql/data:Z \
    --replace --name=restore_db \
    --env POSTGRES_USER=postgres \
    --env POSTGRES_PASSWORD="${POSTGRES_PASSWORD}" \
    --env POSTGRES_MULTIPLE_DATABASES=bbb_graphql,hasura_app,greenlight \
    --env TZ=UTC \
    "${POSTGRES_IMAGE}"

# If the restore is successful, clean up
rm -rfv restore/ bbb_graphql.pg_dump hasura_app.pg_dump greenlight.pg_dump
