#
# The non-secret environment; Restic restores state/passwords.env directly.
#
# No port variables: the restored node gets a fresh allocation, and carrying the
# old numbers over would claim ports it never reserved.
#

import sys
import json
import agent

request = json.load(sys.stdin)
original_environment = request["environment"]

for evar in [
        "TRAEFIK_HOST",
        "PUBLIC_IP",
        "PRIVATE_IP",
        "BEHIND_NAT",
        "MS_WEBRTC_LISTEN_IPS",
        "STUN_SERVER",
        "TURN_EXT_SERVER",
        "ENABLE_RECORDING",
        "RECORDING_MAX_AGE_DAYS",
        "ENABLE_LEARNING_DASHBOARD",
        "ENABLE_EXTERNAL_VIDEOS",
        "ENABLE_BREAKOUT_ROOMS",
        "SHOW_PRESENTATION_ON_JOIN",
        "LEARNING_DASHBOARD_MAX_AGE_DAYS",
        "SOUNDS_LANGUAGE",
        "DISABLE_SOUND_MUTED",
        "DISABLE_SOUND_ALONE",
        "WELCOME_MESSAGE",
        "WELCOME_FOOTER",
    ]:
    if evar in original_environment:
        agent.set_env(evar, original_environment[evar])

agent.dump_env()
