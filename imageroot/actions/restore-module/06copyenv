#
# Restore the non-secret environment. Secrets are not here: they live in
# state/passwords.env, which Restic restores directly.
#
# Port variables are deliberately absent. The platform allocates a fresh range
# on the restored node from the labels in build-images.sh, and create-module's
# 05setenvs splits it: carrying over the old node's port numbers would restore
# an allocation this node never made.
#

import sys
import json
import agent

request = json.load(sys.stdin)
original_environment = request["environment"]

for evar in [
        "TRAEFIK_HOST",
        "PUBLIC_IP",
        "PRIVATE_IP",
        "BEHIND_NAT",
        "MS_WEBRTC_LISTEN_IPS",
        "STUN_SERVER",
        "TURN_EXT_SERVER",
        "ENABLE_RECORDING",
        "REMOVE_OLD_RECORDING",
        "RECORDING_MAX_AGE_DAYS",
        "ENABLE_LEARNING_DASHBOARD",
        "SOUNDS_LANGUAGE",
        "DISABLE_SOUND_MUTED",
        "DISABLE_SOUND_ALONE",
        "WELCOME_MESSAGE",
        "WELCOME_FOOTER",
    ]:
    if evar in original_environment:
        agent.set_env(evar, original_environment[evar])

agent.dump_env()
