#
# Create a Greenlight administrator.
#
# Signing up through the form always yields the User role -- DefaultRole in
# Greenlight's settings -- and the admin panel is invisible to anyone else, so
# a fresh instance has no way in without this. It also matters after a restore
# or a reinstall, where the Greenlight database starts empty again.
#
# The password is used once and never stored by this module: Greenlight hashes
# it into its own database.
#

import json
import subprocess
import sys

import agent

data = json.load(sys.stdin)

name = data["name"]
email = data["email"]
password = data["password"]

# rake takes its arguments inside brackets. Passed as a single argv element, so
# a comma or a quote in the password cannot break out into another argument.
result = subprocess.run(
    ["podman", "exec", "greenlight-app", "bundle", "exec",
     f"rake", f"admin:create[{name},{email},{password}]"],
    capture_output=True, text=True, timeout=120,
)

if result.returncode != 0:
    agent.set_status('validation-failed')
    json.dump([{
        'field': 'email', 'parameter': 'email', 'value': email,
        'error': 'admin_creation_failed',
    }], fp=sys.stdout)
    # The password may appear in rake's echo of its own arguments, so report the
    # failure without replaying the command line.
    print(agent.SD_ERR + "rake admin:create failed", file=sys.stderr)
    print(result.stdout[-500:], file=sys.stderr)
    sys.exit(3)

print(f"Greenlight administrator created: {email}", file=sys.stderr)
json.dump({"email": email}, fp=sys.stdout)
