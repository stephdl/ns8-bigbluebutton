#
# Store the external TURN secret, which BigBlueButton needs to sign the
# time-limited credentials it hands each client: TurnServer.generatePasswordFor()
# computes HMAC-SHA1(expiry:userId, secret), and coturn recomputes it from its own
# static-auth-secret. An empty secret means every allocation is refused.
#
# It goes to state/passwords.env, not agent.set_env(): that would make it a
# permanent module variable in Redis, in plain text. bbb-web already gets the file
# as an --env-file, so the value reaches dockerize with no further wiring.
#
# Omitted means "keep what is there", since get-configuration never returns it.
#

import os
import sys
import json
import agent

data = json.load(sys.stdin)

path = os.path.join(os.environ["AGENT_STATE_DIR"], "passwords.env")
secrets = agent.read_envfile(path) if os.path.exists(path) else {}

if "turn_ext_secret" in data and data["turn_ext_secret"] != secrets.get("TURN_EXT_SECRET", ""):
    secrets["TURN_EXT_SECRET"] = data["turn_ext_secret"]

    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fp:
        for key, value in sorted(secrets.items()):
            print(f"{key}={value}", file=fp)
    os.replace(tmp, path)

    print("cleared the TURN secret" if not data["turn_ext_secret"]
          else "stored the TURN secret", file=sys.stderr)

if data["turn_ext_server"] and not secrets.get("TURN_EXT_SECRET", ""):
    print(agent.SD_WARNING + "a TURN server is configured without a shared "
          "secret: BigBlueButton signs every client credential with it, so the "
          "server will refuse them all", file=sys.stderr)
