set -e

# Redirect any output to the journal (stderr)
exec 1>&2

#
# Every unit is named explicitly: systemd does NOT cascade a restart from the pod
# unit to the containers that joined it, so restarting bigbluebutton.service alone
# brings the pod up and leaves all sixteen containers down.
#
# restart, not try-restart, which is a no-op on a unit that is not running and
# would start nothing on the first configure. update-module.d/20restart is where
# try-restart is the correct one.
#
UNITS=(
    # pod, then its datastores
    bigbluebutton.service
    postgres-app.service
    redis-app.service
    # host namespace: freeswitch comes before its clients, fsesl-akka in the
    # pod and webrtc-sfu on the host
    freeswitch.service
    etherpad-app.service
    bbb-pads-app.service
    bbb-web-app.service
    apps-akka-app.service
    fsesl-akka-app.service
    bbb-graphql-actions-app.service
    bbb-graphql-server-app.service
    bbb-graphql-middleware-app.service
    bbb-export-annotations-app.service
    greenlight-app.service
    nginx-app.service
    webrtc-sfu.service
)

# Recording is opt-in, as upstream gates both of these on ENABLE_RECORDING
# (docker-compose.tmpl.yml:427-474). Recordings capture everything that happens
# in a conference, so they stay off until explicitly enabled.
RECORDING_UNITS=(
    recordings-app.service
    bbb-webrtc-recorder.service
)

# Read the one value we need without sourcing the file. state/environment is a
# systemd EnvironmentFile, not a shell script: MS_WEBRTC_LISTEN_IPS holds JSON
# with spaces in it, and sourcing that makes bash try to run "0.0.0.0," as a
# command.
ENABLE_RECORDING=$(sed -n 's/^ENABLE_RECORDING=//p' "${AGENT_STATE_DIR}/environment" | head -1)

if [ "${ENABLE_RECORDING}" = "true" ]; then
    UNITS+=("${RECORDING_UNITS[@]}")
else
    systemctl --user disable --now "${RECORDING_UNITS[@]}" || true
fi

systemctl --user enable "${UNITS[@]}"
systemctl --user restart "${UNITS[@]}"

# Maintenance timer: FreeSWITCH clock resync, stale presentation cleanup and,
# when enabled, recording retention. Replaces the upstream `periodic` container.
systemctl --user enable --now bigbluebutton-periodic.timer
