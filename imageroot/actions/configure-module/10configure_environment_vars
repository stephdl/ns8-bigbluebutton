import json
import os
import sys
import agent

data = json.load(sys.stdin)

agent.set_env("TRAEFIK_HOST", data["host"])
agent.set_env("TRAEFIK_LETS_ENCRYPT", str(data.get("lets_encrypt", False)).lower())

# mediasoup binds an address the node owns and announces the one clients reach,
# which is why these are two fields and not one. The core cannot supply the
# public one: get-facts anonymises default_ipv4 through pseudo_ip().
#
# An explicit value wins over detection, which cannot know about a port-forward.
public_address = data["public_address"] or os.environ.get("DETECTED_PUBLIC_IP", "")
agent.assert_exp(bool(public_address),
                 "public_address is required and could not be detected")
agent.set_env("PUBLIC_IP", public_address)

listen_ips = [{"ip": "0.0.0.0", "announcedIp": public_address}]

# A second entry spares internal clients NAT reflection, which many routers lack.
private_address = data["private_address"]
if private_address:
    listen_ips.append({"ip": private_address, "announcedIp": private_address})
    agent.set_env("PRIVATE_IP", private_address)
    agent.set_env("BEHIND_NAT", "true")
else:
    agent.set_env("PRIVATE_IP", "")
    agent.set_env("BEHIND_NAT", "false")

# Compact separators: state/environment is also read by shell helpers, and a
# space in the value trips anything that sources the file.
agent.set_env("MS_WEBRTC_LISTEN_IPS", json.dumps(listen_ips, separators=(",", ":")))

# Empty by default: the module ships no coturn, and sample.env's public default
# would send every client's IP to a third party.
agent.set_env("STUN_SERVER", data["stun_server"])
agent.set_env("TURN_EXT_SERVER", data["turn_ext_server"])

agent.set_env("ENABLE_RECORDING", str(data["enable_recording"]).lower())
agent.set_env("REMOVE_OLD_RECORDING", str(data["remove_old_recording"]).lower())
agent.set_env("RECORDING_MAX_AGE_DAYS", str(data["recording_max_age_days"]))
agent.set_env("ENABLE_LEARNING_DASHBOARD", str(data["enable_learning_dashboard"]).lower())
agent.set_env("ENABLE_EXTERNAL_VIDEOS", str(data["enable_external_videos"]).lower())
agent.set_env("ENABLE_BREAKOUT_ROOMS", str(data["enable_breakout_rooms"]).lower())

# bbb-web disables a feature by naming it, so send the complement of the toggles.
# A list, not one key per feature: the next one costs a line here.
agent.set_env("DISABLED_FEATURES", ",".join(feature for feature, wanted in (
    ("learningDashboard", data["enable_learning_dashboard"]),
    ("externalVideos", data["enable_external_videos"]),
    ("breakoutRooms", data["enable_breakout_rooms"]),
) if not wanted))
agent.set_env("LEARNING_DASHBOARD_MAX_AGE_DAYS", str(data["learning_dashboard_max_age_days"]))
# bbb-web wants minutes and dockerize cannot multiply.
agent.set_env("LEARNING_DASHBOARD_CLEANUP_MINUTES",
              str(data["learning_dashboard_max_age_days"] * 1440))
agent.set_env("SOUNDS_LANGUAGE", data["sounds_language"])
agent.set_env("DISABLE_SOUND_MUTED", str(data["disable_sound_muted"]).lower())
agent.set_env("DISABLE_SOUND_ALONE", str(data["disable_sound_alone"]).lower())
agent.set_env("WELCOME_MESSAGE", data["welcome_message"])
agent.set_env("WELCOME_FOOTER", data["welcome_footer"])

print("Environment configured", file=sys.stderr)
