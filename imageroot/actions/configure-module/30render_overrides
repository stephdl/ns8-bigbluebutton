#
# Render state/overrides/, then report on the certificate Traefik serves.
#
# The rendering is bin/render-overrides, shared with the pod unit's ExecStartPre.
# Only the certificate check lives here: it needs Traefik listening and it writes
# to state/environment, so it belongs to configuring rather than to rendering.
#

import os
import socket
import ssl
import subprocess
import sys

import agent
from cryptography import x509
from cryptography.x509.oid import ExtensionOID, NameOID

subprocess.run([os.path.join(os.environ["AGENT_INSTALL_DIR"], "bin", "render-overrides")],
               check=True)

env = agent.read_envfile(os.path.join(os.environ["AGENT_STATE_DIR"], "environment"))
host = env["TRAEFIK_HOST"]

# Only the browser's problem -- the containers validate the internal certificate
# instead -- but still worth reporting: without a certificate for this name
# browsers refuse microphone and camera access, and nothing says so until a room
# is started.
try:
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    with socket.create_connection(("127.0.0.1", 443), timeout=10) as sock:
        # SNI matters: Traefik picks the certificate from the requested name.
        with ctx.wrap_socket(sock, server_hostname=host) as tls:
            der = tls.getpeercert(binary_form=True)

    parsed = x509.load_der_x509_certificate(der)
    names = set()
    try:
        names.update(parsed.extensions.get_extension_for_oid(
            ExtensionOID.SUBJECT_ALTERNATIVE_NAME).value.get_values_for_type(x509.DNSName))
    except x509.ExtensionNotFound:
        pass
    names.update(a.value for a in parsed.subject.get_attributes_for_oid(NameOID.COMMON_NAME))

    matches = any(
        n == host or (n.startswith("*.") and host.split(".", 1)[-1] == n[2:])
        for n in names
    )
    agent.set_env("CERTIFICATE_MATCHES_HOST", str(matches).lower())
    if matches:
        print(f"Traefik serves a certificate valid for {host}", file=sys.stderr)
    else:
        print(agent.SD_WARNING + f"Traefik serves a certificate for {sorted(names)}, "
              f"not for {host}. Rooms still work, but browsers will refuse "
              f"microphone and camera access until this is fixed.",
              file=sys.stderr)
except Exception as ex:
    # Not fatal: Traefik may not be serving yet on a first install.
    agent.set_env("CERTIFICATE_MATCHES_HOST", "false")
    print(agent.SD_WARNING + f"could not read the Traefik certificate: {ex}", file=sys.stderr)
