# Before any step changes the route or the environment: a refusal here must
# leave the module as it was.
#

import json
import os
import subprocess
import sys

import agent

data = json.load(sys.stdin)

# Omitted keeps the current state, like turn_ext_secret: a caller that predates
# the field must not switch TURN off behind the administrator's back.
enabled = data.get("turn_enabled", os.environ.get("TURN_ENABLED") == "true")

if enabled:
    owner = subprocess.run(["turn-port-owner"], capture_output=True, text=True)
    if owner.returncode != 0:
        print(agent.SD_ERR + "port 3478 is already in use on this node:\n" + owner.stdout,
              file=sys.stderr)
        agent.set_status("validation-failed")
        json.dump([{"field": "turn_enabled", "parameter": "turn_enabled",
                    "value": True, "error": "turn_port_in_use"}], fp=sys.stdout)
        sys.exit(2)
