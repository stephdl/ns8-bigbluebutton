#
# Turn the built-in TURN server on or off, then recompute the UDP split and the
# firewall: the listener port is public only while TURN is on.
#

import json
import subprocess
import sys

import agent

data = json.load(sys.stdin)

enabled = data.get("turn_enabled", False)

if enabled:
    owner = subprocess.run(["turn-port-owner"], capture_output=True, text=True)
    if owner.returncode != 0:
        print(agent.SD_ERR + "port 3478 is already in use on this node:\n" + owner.stdout,
              file=sys.stderr)
        agent.set_status("validation-failed")
        json.dump([{"field": "turn_enabled", "parameter": "turn_enabled",
                    "value": True, "error": "turn_port_in_use"}], fp=sys.stdout)
        sys.exit(2)

agent.set_env("TURN_ENABLED", str(enabled).lower())

agent.run_helper("apply-port-layout").check_returncode()
