#
# Turn the built-in TURN server on or off, then recompute the UDP split and the
# firewall: the listener port is public only while TURN is on. The port check
# already ran in 02turn_validation.
#

import json
import os
import sys

import agent

data = json.load(sys.stdin)

enabled = data.get("turn_enabled", os.environ.get("TURN_ENABLED") == "true")
agent.set_env("TURN_ENABLED", str(enabled).lower())

agent.run_helper("apply-port-layout").check_returncode()
