#
# Print "true" while the bootstrap administrator still has the shipped password.
#
# The digest is bcrypt, so it must be verified against its salt: hence the hop
# into the container, where the gem lives.
#

import subprocess
import sys

# Mirrored by bin/seed-default-admin and settings.default_admin_description in
# ui/public/i18n/en/translation.json. Change all three together.
DEFAULT_EMAIL = "admin@nethserver.org"
DEFAULT_PASSWORD = "Nethesis,1234"


def run(cmd, **kwargs):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=60, **kwargs)


digest = run([
    "podman", "exec", "postgres-app", "psql", "-U", "postgres", "-d", "greenlight",
    "-tAc", f"SELECT password_digest FROM users WHERE email = '{DEFAULT_EMAIL}'",
])

if digest.returncode != 0 or not digest.stdout.strip():
    print("false")  # no such account, nothing to warn about
    sys.exit(0)

verify = run([
    "podman", "exec", "-e", f"DIGEST={digest.stdout.strip()}",
    "-w", "/usr/src/app", "greenlight-app",
    "bundle", "exec", "ruby", "-e",
    'require "bcrypt"; '
    f'puts(BCrypt::Password.new(ENV["DIGEST"]) == {DEFAULT_PASSWORD!r})',
])

print("true" if verify.returncode == 0 and verify.stdout.strip() == "true" else "false")
