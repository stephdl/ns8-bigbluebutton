#!/bin/bash

#
# Copyright (C) 2026 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# Replaces the `periodic` container from bigbluebutton/docker: podman exec from
# the host does its work without the Docker socket the container existed to hold.
#
# No `set -e` on purpose: one failing job must not stop the others.
#

exec 1>&2 # Redirect any output to the journal

# Upstream default, hardcoded as history=5 in mod/periodic/entrypoint.sh.
PRESENTATION_MAX_AGE_DAYS=5

# runagent provides the module environment; secrets are deliberately not in it.
if [ -f "${AGENT_STATE_DIR}/passwords.env" ]; then
    # shellcheck source=/dev/null
    . "${AGENT_STATE_DIR}/passwords.env"
fi

#
# 1. Resynchronise the FreeSWITCH clock
#
# ESL is on loopback because FreeSWITCH shares the host namespace. The password
# is required, unlike in upstream's mod/periodic/bbb-resync-freeswitch.
#
if podman container exists freeswitch; then
    podman exec freeswitch /opt/freeswitch/bin/fs_cli \
        -H 127.0.0.1 -p "${FSESL_PASSWORD}" \
        -x 'fsctl sync_clock_when_idle' \
        || echo "bigbluebutton-periodic: FreeSWITCH clock resync failed"
else
    echo "bigbluebutton-periodic: freeswitch container is not running, skipping clock resync"
fi

#
# The remaining jobs walk the recordings volume from the host. Resolve it once.
#
BBB_VOLUME=$(podman volume inspect bigbluebutton --format '{{.Mountpoint}}' 2>/dev/null)

if [ -z "${BBB_VOLUME}" ] || [ ! -d "${BBB_VOLUME}" ]; then
    echo "bigbluebutton-periodic: cannot resolve the bigbluebutton volume, skipping cleanup"
    exit 0
fi

#
# 2. Make sure the instance has an administrator, in case the database was not
#    ready when Greenlight last started.
seed-default-admin --wait 0 || echo "bigbluebutton-periodic: administrator check failed"

#
# 3. Drop stale presentation upload directories
#
# The volume belongs to the container's rootless user namespace, not the host
# UID this script runs as: an rm here would get "Permission denied" and this
# stage would silently never delete anything. podman unshare re-execs the
# rm in that namespace, where the container's root actually owns the files.
find "${BBB_VOLUME}/" -maxdepth 1 -type d -name "*-[0-9]*" \
    -mtime "+${PRESENTATION_MAX_AGE_DAYS}" -print0 \
    | podman unshare xargs -0 --no-run-if-empty rm -rf \
    || echo "bigbluebutton-periodic: presentation cleanup failed"

#
# 4. Delete learning dashboards past their retention
#
# Before the recording section, which exits early when recording is off. bbb-web
# also schedules this, but from a timer a restart loses.
#
: "${LEARNING_DASHBOARD_MAX_AGE_DAYS:=0}"
LD_DIR="${BBB_VOLUME}/learning-dashboard"

if [ "${LEARNING_DASHBOARD_MAX_AGE_DAYS}" != "0" ] && [ -d "${LD_DIR}" ]; then
    find "${LD_DIR}" -mindepth 1 -maxdepth 1 -type d \
        -mtime "+${LEARNING_DASHBOARD_MAX_AGE_DAYS}" -print0 \
        | podman unshare xargs -0 --no-run-if-empty rm -rf \
        || echo "bigbluebutton-periodic: learning dashboard cleanup failed"
fi

#
# 5. Delete recordings past their retention
#
# Through bbb-record: removing the directories directly would leave the database
# and the published tree inconsistent.
#
if [ "${ENABLE_RECORDING}" != "true" ]; then
    exit 0
fi

: "${RECORDING_MAX_AGE_DAYS:=0}"

if [ "${RECORDING_MAX_AGE_DAYS}" = "0" ]; then
    exit 0
fi

if ! podman container exists recordings-app; then
    echo "bigbluebutton-periodic: recordings container is not running, skipping recording cleanup"
    exit 0
fi

NOW=$(date +%s)
shopt -s nullglob

delete_if_expired() {
    local mtime="$1" meeting_id="$2"
    if [ $(( (NOW - mtime) / 86400 )) -gt "${RECORDING_MAX_AGE_DAYS}" ]; then
        echo "bigbluebutton-periodic: deleting recording ${meeting_id}"
        podman exec recordings-app bbb-record --delete "${meeting_id}" \
            || echo "bigbluebutton-periodic: failed to delete ${meeting_id}"
    fi
}

# Published recordings
for donefile in "${BBB_VOLUME}"/recording/status/published/*-presentation.done; do
    meeting_id=$(basename "${donefile}")
    delete_if_expired "$(stat -c %Y "${donefile}")" "${meeting_id%-presentation.done}"
done

# Raw stage, never published
for eventsfile in "${BBB_VOLUME}"/recording/raw/*/events.xml; do
    meeting_id="${eventsfile%/events.xml}"
    delete_if_expired "$(stat -c %Y "${eventsfile}")" "${meeting_id##*/}"
done
