#
# Push the module's registration settings into Greenlight's own database.
#
# Greenlight keeps them in site_settings rather than in its environment, and
# seeds that table on first boot, so they cannot simply be passed as variables:
# they have to be written after the seed has run. Applied on every configure, so
# the module stays the source of truth even if someone edits them in the
# Greenlight admin panel.
#

import os
import subprocess
import sys
import time

import agent

SETTINGS = {
    # open: anyone signs up. invite: only on an admin's invitation.
    # approval: anyone signs up, an admin activates the account.
    "RegistrationMethod": os.environ.get("REGISTRATION_METHOD", "open"),
    # Comma-separated list of email domains. Empty accepts any domain.
    "AllowedDomains": os.environ.get("ALLOWED_DOMAINS", ""),
}

UPDATE = (
    "UPDATE site_settings SET value = :'value', updated_at = now() "
    "FROM settings "
    "WHERE settings.id = site_settings.setting_id AND settings.name = :'name'"
)


def psql(sql, **params):
    """Run a statement, letting psql quote the parameters.

    Values reach here from admin input, so they are never interpolated into the
    SQL text: :'name' asks psql for a properly quoted literal.
    """
    cmd = ["podman", "exec", "postgres-app", "psql", "-U", "postgres",
           "-d", "greenlight", "-tAc", sql]
    for key, value in params.items():
        cmd[6:6] = ["-v", f"{key}={value}"]
    return subprocess.run(cmd, capture_output=True, text=True, timeout=30)


# Greenlight seeds this table at its first boot and would overwrite anything
# written before. Wait for the row instead of racing it.
for _ in range(30):
    probe = psql("SELECT count(*) FROM settings WHERE name = 'RegistrationMethod'")
    if probe.returncode == 0 and probe.stdout.strip() not in ("", "0"):
        break
    time.sleep(2)
else:
    print(agent.SD_WARNING + "Greenlight has not seeded its settings yet; "
          "registration settings will be applied on the next configure",
          file=sys.stderr)
    sys.exit(0)  # not fatal

for name, value in SETTINGS.items():
    result = psql(UPDATE, name=name, value=value)
    if result.returncode != 0:
        print(agent.SD_WARNING + f"could not set {name}: {result.stderr.strip()}",
              file=sys.stderr)
    else:
        print(f"Greenlight {name} = {value or '(any)'}", file=sys.stderr)
