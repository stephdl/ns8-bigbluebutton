#
# Drop Greenlight's row for one recording, given its internal meeting id.
#
# Shared by actions/delete-recording and bin/bigbluebutton-periodic: both delete the
# files with bbb-record, and both have to remove this row first. In SQL, not through
# the Rails model, whose after_destroy asks BigBlueButton to delete the recording --
# once the files are gone that raises and rolls back, leaving a row nothing can
# remove, Greenlight's own delete button included.
#
# Exits 0 when there was no row: nothing to do is not a failure.
#

import re
import sys
import subprocess

import greenlight_db

if len(sys.argv) != 2:
    print(f"usage: {sys.argv[0]} <internal_meeting_id>", file=sys.stderr)
    sys.exit(2)

meeting_id = sys.argv[1]

# The value is interpolated into SQL below. Callers read it off a filename or a task
# payload, so check it here rather than trusting either.
if not re.fullmatch(r"[0-9a-f]{40}-[0-9]+", meeting_id):
    print(f"malformed meeting identifier: {meeting_id}", file=sys.stderr)
    sys.exit(2)

if subprocess.run(["podman", "container", "exists", "postgres-app"],
                  capture_output=True).returncode != 0:
    print("PostgreSQL is not running", file=sys.stderr)
    sys.exit(1)

# formats before recordings: foreign key.
result = greenlight_db.psql(
    "DELETE FROM formats WHERE recording_id IN "
    f"(SELECT id FROM recordings WHERE record_id = '{meeting_id}'); "
    f"DELETE FROM recordings WHERE record_id = '{meeting_id}';"
)

if result.returncode != 0:
    print(f"cannot delete the Greenlight recording: {result.stderr.strip()}",
          file=sys.stderr)
    sys.exit(1)
