#
# Print the sockets bound to the TURN port by something other than our own
# eturnal, and exit 1 if there are any. 3478 is fixed, outside the port
# allocator, so nothing in the platform stops another module from taking it.
#

import subprocess
import sys

TURN_PORT = 3478

ours = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "eturnal.service"]).returncode == 0
if ours:
    sys.exit(0)

# -l lists UDP sockets too, as UNCONN.
out = subprocess.run(
    ["ss", "-Hlntu", f"sport = :{TURN_PORT}"],
    capture_output=True, text=True, check=True,
).stdout.strip()

if out:
    print(out)
    sys.exit(1)
