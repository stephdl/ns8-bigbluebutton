#
# Exit 1 and print the sockets if another user holds port 3478. The port is
# fixed, outside the allocator. Ours are matched by uid, subuids included.
#

import getpass
import os
import re
import subprocess
import sys

TURN_PORT = 3478


def our_uids():
    uid = os.getuid()
    ranges = [(uid, uid)]
    user = getpass.getuser()
    try:
        with open("/etc/subuid") as fp:
            for line in fp:
                name, start, count = line.strip().split(":")
                if name in (user, str(uid)):
                    ranges.append((int(start), int(start) + int(count) - 1))
    except (OSError, ValueError):
        pass
    return ranges


ours = our_uids()

# -e adds the owner as uid:N.
out = subprocess.run(
    ["ss", "-Hlntue", f"sport = :{TURN_PORT}"],
    capture_output=True, text=True, check=True,
).stdout.splitlines()

foreign = []
for line in out:
    m = re.search(r"\buid:(\d+)", line)
    owner = int(m.group(1)) if m else 0
    if not any(lo <= owner <= hi for lo, hi in ours):
        foreign.append(line)

if foreign:
    print("\n".join(foreign))
    sys.exit(1)
