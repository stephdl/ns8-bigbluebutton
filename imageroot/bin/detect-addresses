#
# Work out the addresses mediasoup should bind and announce, and store them as
# DETECTED_PRIVATE_IP and DETECTED_PUBLIC_IP for configure-module to use as
# defaults.
#
# The admin can always override both: this only removes the need to type them.
#
# Nothing here is fatal. A node that cannot be probed still installs; the fields
# are simply left empty and configure-module refuses until they are filled in.
#

import ipaddress
import json
import subprocess
import sys
import urllib.request

import agent

# Echo services used only when the node sits behind NAT, in order. Both return
# a bare address. ns8-ddclient uses the same two.
ECHO_SERVICES = (
    "https://api.ipify.org",
    "https://ipv4.icanhazip.com",
)
ECHO_TIMEOUT = 5


def local_address():
    """Source address the kernel would use to reach the internet.

    Reads the routing table rather than the interface list: a node with several
    interfaces has several addresses, and the one that matters is the one on the
    default path.
    """
    try:
        out = subprocess.run(
            ["ip", "-4", "route", "get", "1.1.1.1"],
            capture_output=True, text=True, timeout=5, check=True,
        ).stdout.split()
        return out[out.index("src") + 1]
    except Exception as ex:
        print(agent.SD_WARNING + f"cannot read the local address: {ex}", file=sys.stderr)
        return ""


def is_public(addr):
    try:
        return ipaddress.ip_address(addr).is_global
    except ValueError:
        return False


def public_address(local):
    """The address clients will reach.

    When the node holds a globally routable address there is nothing to ask
    anyone: it is its own public address. Only a node behind NAT needs an
    outside opinion, and only then is an echo service contacted.
    """
    if is_public(local):
        print(f"{local} is globally routable, no external lookup needed", file=sys.stderr)
        return local

    for url in ECHO_SERVICES:
        try:
            # Named in the log on purpose: this is an outbound request that
            # tells a third party this node exists.
            print(f"node is behind NAT, asking {url} for the public address", file=sys.stderr)
            with urllib.request.urlopen(url, timeout=ECHO_TIMEOUT) as resp:
                candidate = resp.read().decode().strip()
            if is_public(candidate):
                return candidate
            print(agent.SD_WARNING + f"{url} returned {candidate!r}, ignoring", file=sys.stderr)
        except Exception as ex:
            print(agent.SD_WARNING + f"{url} failed: {ex}", file=sys.stderr)

    print(agent.SD_WARNING + "could not determine the public address; it must be set by hand",
          file=sys.stderr)
    return ""


local = local_address()
public = public_address(local) if local else ""

agent.set_env("DETECTED_PRIVATE_IP", local)
agent.set_env("DETECTED_PUBLIC_IP", public)

print(f"detected local={local or '(none)'} public={public or '(none)'}", file=sys.stderr)

# Structured output so the UI can offer a re-detect without re-reading state.
json.dump({"private_address": local, "public_address": public}, fp=sys.stdout)
