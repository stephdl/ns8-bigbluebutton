#!/usr/bin/env python3

#
# Copyright (C) 2026 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# Two callers, peers not layers: configure-module/30render_overrides and
# bigbluebutton.service's ExecStartPre. See docs/packaging-analysis.md section 4.
#

import datetime
import os
import shutil
import sys

import agent
from cryptography import x509
from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import rsa
from cryptography.x509.oid import NameOID

install_dir = os.environ["AGENT_INSTALL_DIR"]
state_dir = os.environ["AGENT_STATE_DIR"]

src_dir = os.path.join(install_dir, "overrides")
dst_dir = os.path.join(state_dir, "overrides")
os.makedirs(dst_dir, exist_ok=True)

# agent.set_env() does not touch os.environ, so read state/environment back.
env = agent.read_envfile(os.path.join(state_dir, "environment"))

# No substitution needed: dockerize resolves these inside the container.
VERBATIM = (
    "turn-stun-servers.xml",
    "bbb-apps-akka.conf",
    "webrtc-sfu.nginx",
    "nginx-default.conf",
    # Every room's first slide, and tldraw only draws over a presentation.
    "default.pdf",
    "bbb-web.properties.tmpl",
)

ENTRYPOINTS = (
    "freeswitch-entrypoint.sh",
    "greenlight-entrypoint.sh",
    "recordings-entrypoint.sh",
    "apps-akka-entrypoint.sh",
    "bbb-web-entrypoint.sh",
)

for name in VERBATIM + ENTRYPOINTS:
    shutil.copyfile(os.path.join(src_dir, name), os.path.join(dst_dir, name))

for name in ENTRYPOINTS:
    os.chmod(os.path.join(dst_dir, name), 0o755)

# Substituted here: neither file has templating of its own.
placeholders = {
    "@@REDIS_PORT@@": env["REDIS_PORT"],
    "@@TRAEFIK_HOST@@": env["TRAEFIK_HOST"],
    "@@MEDIASOUP_MIN_PORT@@": env["MEDIASOUP_MIN_PORT"],
    "@@MEDIASOUP_MAX_PORT@@": env["MEDIASOUP_MAX_PORT"],
}

for name in ("webrtc-sfu-config.yaml", "nginx.conf"):
    with open(os.path.join(src_dir, name + ".in")) as fp:
        content = fp.read()
    for key, value in placeholders.items():
        content = content.replace(key, str(value))
    agent.assert_exp("@@" not in content, f"unsubstituted placeholder in {name}")
    with open(os.path.join(dst_dir, name), "w") as fp:
        fp.write(content)

# A file rather than podman --env: DATABASE_URL embeds a password ps would show.
pw = agent.read_envfile(os.path.join(state_dir, "passwords.env"))
gl_path = os.path.join(dst_dir, "greenlight.env")
gl_fd = os.open(gl_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(gl_fd, "w") as fp:
    print(f"DATABASE_URL=postgres://postgres:{pw['POSTGRES_PASSWORD']}@127.0.0.1:5432/greenlight", file=fp)
    print("REDIS_URL=redis://127.0.0.1:6379", file=fp)
    # Must be the public name: Greenlight also builds the browser join URL from
    # it. That makes Ruby validate the certificate issued below.
    print(f"BIGBLUEBUTTON_ENDPOINT=https://{env['TRAEFIK_HOST']}/bigbluebutton/api", file=fp)
    print(f"BIGBLUEBUTTON_SECRET={pw['SHARED_SECRET']}", file=fp)
    print(f"SECRET_KEY_BASE={pw['RAILS_SECRET']}", file=fp)
    print("RELATIVE_URL_ROOT=/", file=fp)

#
# The containers call the site's public name and validate what answers, so nginx
# serves this on the pod's own 443 and the containers trust it. Traefik cannot
# supply it: upload-certificate rejects a self-signed one unless the whole
# instance switches to selfsign verification, which is not ours to change.
#
internal_crt = os.path.join(dst_dir, "internal.crt")
internal_key = os.path.join(dst_dir, "internal.key")
host = env["TRAEFIK_HOST"]


def covers_host(path, name):
    """True when the certificate on disk is still usable for this hostname."""
    try:
        with open(path, "rb") as fp:
            cert = x509.load_pem_x509_certificate(fp.read())
        if cert.not_valid_after_utc < datetime.datetime.now(datetime.timezone.utc):
            return False
        return name in cert.extensions.get_extension_for_class(
            x509.SubjectAlternativeName).value.get_values_for_type(x509.DNSName)
    except Exception:
        return False


# Reissue only on rename: replacing it on every save would churn trust stores.
if not covers_host(internal_crt, host):
    key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
    name = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, host)])
    now = datetime.datetime.now(datetime.timezone.utc)
    cert = (
        x509.CertificateBuilder()
        .subject_name(name)
        .issuer_name(name)
        .public_key(key.public_key())
        .serial_number(x509.random_serial_number())
        # Backdated: a clock skew must not make it look not-yet-valid.
        .not_valid_before(now - datetime.timedelta(hours=1))
        .not_valid_after(now + datetime.timedelta(days=3650))
        .add_extension(x509.SubjectAlternativeName([x509.DNSName(host)]), critical=False)
        .add_extension(x509.BasicConstraints(ca=False, path_length=None), critical=True)
        .sign(key, hashes.SHA256())
    )
    key_fd = os.open(internal_key, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(key_fd, "wb") as fp:
        fp.write(key.private_bytes(
            serialization.Encoding.PEM,
            serialization.PrivateFormat.TraditionalOpenSSL,
            serialization.NoEncryption(),
        ))
    with open(internal_crt, "wb") as fp:
        fp.write(cert.public_bytes(serialization.Encoding.PEM))
    print(f"issued an internal certificate for {host}", file=sys.stderr)

# The site name is not redirected here: mounting over /etc/hosts would drop the
# pod's --add-host names, so the containers that need it append the entry instead.

# Read by the postgres entrypoint on first start.
initdb_dir = os.path.join(state_dir, "initdb.d")
os.makedirs(initdb_dir, exist_ok=True)
shutil.copyfile(
    os.path.join(src_dir, "postgres-initdb.sh"),
    os.path.join(initdb_dir, "10-create-databases.sh"),
)
os.chmod(os.path.join(initdb_dir, "10-create-databases.sh"), 0o755)

print(f"Rendered overrides in {dst_dir}", file=sys.stderr)
