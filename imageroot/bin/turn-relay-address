#
# Print the first given address that is IPv4 and on this host, else exit 1.
# The relay must reach an address mediasoup announces without a hairpin.
#

import ipaddress
import subprocess
import sys

out = subprocess.run(["ip", "-4", "-o", "addr", "show"],
                     capture_output=True, text=True).stdout
local = {line.split()[3].split("/")[0] for line in out.splitlines() if len(line.split()) > 3}

for addr in sys.argv[1:]:
    try:
        if ipaddress.ip_address(addr).version == 4 and addr in local:
            print(addr)
            sys.exit(0)
    except ValueError:
        pass
sys.exit(1)
