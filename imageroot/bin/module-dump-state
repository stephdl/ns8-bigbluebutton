# SPDX-License-Identifier: GPL-3.0-or-later
#
# Runs with CWD=state/ just before Restic takes the backup. Redis is left out:
# live meeting state is meaningless across a restore.
#

set -e
exec 1>&2 # Redirect any output to the journal (stderr)

# greenlight is the only database holding instance data. bbb-graphql-server drops
# and recreates bbb_graphql on every start, and reapplies hasura_app's metadata
# from the image, so both are derived and a dump of either would only go stale.
echo "Dumping greenlight"
podman exec postgres-app pg_dump -U postgres --format=c greenlight > greenlight.pg_dump
