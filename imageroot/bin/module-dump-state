# SPDX-License-Identifier: GPL-3.0-or-later
#
# Runs with CWD=state/ just before Restic takes the backup. Redis is left out:
# live meeting state is meaningless across a restore.
#

set -e
exec 1>&2 # Redirect any output to the journal (stderr)

# bbb_graphql is absent on purpose: bbb-graphql-server recreates it on every
# start. hasura_app is different -- start.sh creates that one only when absent.
for db in hasura_app greenlight; do
    echo "Dumping ${db}"
    podman exec postgres-app pg_dump -U postgres --format=c "${db}" > "${db}.pg_dump"
done
