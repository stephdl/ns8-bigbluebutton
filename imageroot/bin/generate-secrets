#!/usr/bin/env python3

#
# Copyright (C) 2026 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# Generate any missing secret into state/passwords.env.
#
# Called from create-module at install and from update-module.d on upgrade. The
# second call is what matters: create-module never runs again, so a secret added
# to this module later would otherwise never exist on an instance installed
# before it, and would fail wherever it is first read.
#
# These must not go through agent.set_env(): that writes to Redis in plain text,
# readable by every module on the node. SHARED_SECRET there would let any
# co-installed module forge BigBlueButton API calls, and FSESL_PASSWORD would
# hand over the FreeSWITCH command socket.
#

import os
import secrets
import sys

import agent

path = os.path.join(os.environ["AGENT_STATE_DIR"], "passwords.env")

# Existing secrets are never regenerated: rotating them would orphan the
# database and invalidate every running meeting.
existing = agent.read_envfile(path) if os.path.exists(path) else {}

generated = {
    # BigBlueButton API shared secret: signs every API call
    "SHARED_SECRET": secrets.token_hex(32),
    # Etherpad admin API key, shared with bbb-pads
    "ETHERPAD_API_KEY": secrets.token_hex(32),
    # PostgreSQL superuser password. The variable name is what the postgres
    # image expects; apps-akka, bbb-graphql-server and Greenlight read it too.
    "POSTGRES_PASSWORD": secrets.token_urlsafe(24),
    # FreeSWITCH event socket password
    "FSESL_PASSWORD": secrets.token_urlsafe(24),
    # Hasura admin secret. Upstream ships the literal TODO_CHANGE_ME
    # (docker-compose.tmpl.yml:325).
    "HASURA_GRAPHQL_ADMIN_SECRET": secrets.token_urlsafe(24),
    # Rails SECRET_KEY_BASE for Greenlight. Rails wants a long hex string;
    # anything short weakens session and cookie signing.
    "RAILS_SECRET": secrets.token_hex(64),
}

# Keep whatever is already there, fill in the rest.
final = dict(generated)
final.update(existing)

# freeswitch and webrtc-sfu read ESL_PASSWORD, fsesl-akka reads FSESL_PASSWORD.
# Derived after the merge, so it always tracks the value actually in use rather
# than a freshly generated one that nothing else knows about.
final["ESL_PASSWORD"] = final["FSESL_PASSWORD"]

added = sorted(k for k in final if k not in existing)
if not added:
    print("all secrets already present", file=sys.stderr)
    sys.exit(0)

# Written 0600 from the start, then moved into place: never briefly
# world-readable, and never a half-written file.
tmp = path + ".tmp"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as fp:
    for key, value in sorted(final.items()):
        print(f"{key}={value}", file=fp)
os.replace(tmp, path)

print(f"Generated {len(added)} secret(s): {' '.join(added)}", file=sys.stderr)
