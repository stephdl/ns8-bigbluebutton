#
# Generate any missing secret into state/passwords.env. Also called from
# update-module.d, so a secret added later reaches an older instance.
#
# Never agent.set_env(): that writes to Redis in plain text, where any
# co-installed module could read SHARED_SECRET and forge API calls.
#

import os
import secrets
import sys

import agent

path = os.path.join(os.environ["AGENT_STATE_DIR"], "passwords.env")

# Never regenerated: rotating would orphan the database and every meeting.
existing = agent.read_envfile(path) if os.path.exists(path) else {}

generated = {
    "SHARED_SECRET": secrets.token_hex(32),
    "ETHERPAD_API_KEY": secrets.token_hex(32),
    "POSTGRES_PASSWORD": secrets.token_urlsafe(24),
    "FSESL_PASSWORD": secrets.token_urlsafe(24),
    # Upstream ships the literal TODO_CHANGE_ME (docker-compose.tmpl.yml:325).
    "HASURA_GRAPHQL_ADMIN_SECRET": secrets.token_urlsafe(24),
    # Rails SECRET_KEY_BASE: a short value weakens session and cookie signing.
    "RAILS_SECRET": secrets.token_hex(64),
}

final = dict(generated)
final.update(existing)

# freeswitch and webrtc-sfu read ESL_PASSWORD, fsesl-akka reads FSESL_PASSWORD.
# After the merge, so it tracks the value actually in use.
final["ESL_PASSWORD"] = final["FSESL_PASSWORD"]

added = sorted(k for k in final if k not in existing)
if not added:
    print("all secrets already present", file=sys.stderr)
    sys.exit(0)

# 0600 from the start, then moved: never world-readable, never half-written.
tmp = path + ".tmp"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as fp:
    for key, value in sorted(final.items()):
        print(f"{key}={value}", file=fp)
os.replace(tmp, path)

print(f"Generated {len(added)} secret(s): {' '.join(added)}", file=sys.stderr)
