#!/usr/bin/env python3

#
# Copyright (C) 2026 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# Translate the cluster smarthost settings into the SMTP variables Greenlight
# expects, and write them to state/smarthost.env.
#
# Greenlight sends account-verification and password-reset mail; without this it
# cannot complete a signup. Run as ExecStartPre of greenlight-app and again from
# the smarthost-changed event handler, so a change to the cluster setting is
# picked up without reconfiguring the module.
#
# The file carries the relay password, so it is written 0600.
#

import os
import sys

import agent

# The local replica, so the module still starts when the leader is unreachable.
rdb = agent.redis_connect(use_replica=True)
smtp = agent.get_smarthost_settings(rdb)

envfile = "smarthost.env"

if not smtp["enabled"]:
    print("smarthost is not configured; Greenlight will not be able to send mail",
          file=sys.stderr)

# Greenlight is Rails: SMTP_AUTH and SMTP_STARTTLS_AUTO are ActionMailer
# settings, not the cluster's own vocabulary, so map rather than copy.
# "none" is what Rails wants when the relay takes no credentials; passing an
# empty username with auth=plain makes it fail instead.
auth = "plain" if smtp["username"] else "none"
starttls = "true" if smtp["encrypt_smtp"] == "starttls" else "false"

# HELO domain and envelope sender. The module has no mail identity of its own,
# so borrow the site hostname rather than inventing one.
domain = os.environ.get("TRAEFIK_HOST", "")

lines = [
    f"SMTP_SERVER={smtp['host']}",
    f"SMTP_PORT={smtp['port']}",
    f"SMTP_DOMAIN={domain}",
    f"SMTP_USERNAME={smtp['username']}",
    f"SMTP_PASSWORD={smtp['password']}",
    f"SMTP_AUTH={auth}",
    f"SMTP_STARTTLS_AUTO={starttls}",
    f"SMTP_SENDER_EMAIL=no-reply@{domain}" if domain else "SMTP_SENDER_EMAIL=",
    "SMTP_SENDER_NAME=BigBlueButton",
]

# Write 0600 then move into place: never briefly world-readable, and never a
# half-written file for the container to read.
tmp = envfile + ".tmp"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as efp:
    for line in lines:
        print(line, file=efp)
os.replace(tmp, envfile)

print(f"smarthost discovery: host={smtp['host'] or '(unset)'} port={smtp['port']} auth={auth}",
      file=sys.stderr)
