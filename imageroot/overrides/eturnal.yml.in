#
# Built-in TURN server, rendered by bin/render-overrides. The secret comes from
# ETURNAL_SECRET in state/eturnal.env, so this file holds nothing confidential.
#
eturnal:
  listen:
    - ip: "@@TURN_LISTEN_IP@@"
      port: 3478
      transport: udp
    - ip: "@@TURN_LISTEN_IP@@"
      port: 3478
      transport: tcp

  realm: "@@TRAEFIK_HOST@@"

  # An address this host owns: the relay talks to mediasoup on this same host,
  # never through the router.
  relay_ipv4_addr: "@@RELAY_IPV4_ADDR@@"
  relay_min_port: @@TURN_RELAY_MIN_PORT@@
  relay_max_port: @@TURN_RELAY_MAX_PORT@@

  # The relay must only reach BigBlueButton itself: mediasoup announces these
  # addresses and nothing else. Everything private stays refused, so the TURN
  # server cannot be used as a door into the LAN.
  blacklist_peers:
    - recommended
  whitelist_peers: @@WHITELIST_PEERS@@

  log_dir: stdout
  log_level: notice
  modules:
    mod_log_stun: {}
