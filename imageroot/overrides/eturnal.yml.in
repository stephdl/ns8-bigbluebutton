#
# Rendered by bin/render-overrides. The secret comes from state/eturnal.env.
#
eturnal:
  listen:
    - ip: "@@TURN_LISTEN_IP@@"
      port: 3478
      transport: udp
    - ip: "@@TURN_LISTEN_IP@@"
      port: 3478
      transport: tcp

  realm: "@@TRAEFIK_HOST@@"

  # Must be owned by this host.
  relay_ipv4_addr: "@@RELAY_IPV4_ADDR@@"
  relay_min_port: @@TURN_RELAY_MIN_PORT@@
  relay_max_port: @@TURN_RELAY_MAX_PORT@@

  # Relay to BigBlueButton only, never to the rest of the LAN.
  blacklist_peers:
    - recommended
  whitelist_peers: @@WHITELIST_PEERS@@

  log_dir: stdout
  log_level: notice
  modules:
    mod_log_stun: {}
