# Replaces /etc/nginx/nginx.conf from alangecker/bbb-docker-nginx. Only the two
# server blocks below differ, both replacing hardcoded compose addresses.
#
# Double at-signs are substituted by configure-module, which then asserts none are
# left -- so never write that marker anywhere, comments included.

user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

worker_rlimit_nofile 20000;

events {
    worker_connections 10000;
}


http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    #tcp_nopush     on;

    keepalive_timeout  65;

    #gzip  on;

    include /etc/nginx/conf.d/*.conf;


    server {
        # Greenlight reaches the API here over plain HTTP, validating no
        # certificate; anything meant for a browser goes to the public name.
        listen 48083 http2;

        location /bigbluebutton/api/join {
            return 301 https://@@TRAEFIK_HOST@@$request_uri;
        }
        location /bigbluebutton/api {
            proxy_pass http://127.0.0.1:48087;
        }
        location / {
            return 301 https://@@TRAEFIK_HOST@@$request_uri;
        }
    }

    server {
        # The pod answering for its own public name, for the containers that
        # must use it: the name ends up in URLs handed to somebody else, and they
        # validate whatever certificate answers.
        #
        # A faithful stand-in rather than a special case -- the whole site goes to
        # 48087, where Traefik sends it too -- so no per-caller rule is needed.
        # Nothing outside the pod reaches this listener.
        listen 443 ssl http2;
        server_name @@TRAEFIK_HOST@@;

        ssl_certificate     /etc/nginx/internal/internal.crt;
        ssl_certificate_key /etc/nginx/internal/internal.key;

        location / {
            proxy_pass http://127.0.0.1:48087;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            # Without it Greenlight answers redirects on http and the caller
            # loses the request.
            proxy_set_header X-Forwarded-Proto https;
        }
    }

}
