# Mounted as production.yml, which overrides the image's own copy.
#
# Replaces mod/webrtc-sfu/config.yaml from bigbluebutton/docker: every address
# upstream sets is a compose bridge literal, and this container is on the host.
#
# Double at-signs are substituted by configure-module, which then asserts none are
# left -- so never write that marker anywhere, comments included.

kurento: []

# Pod Redis. NOT 6379: the node's own Redis already owns that on the host.
redisHost: 127.0.0.1
redisPort: @@REDIS_PORT@@

recordingAdapter: bbb-webrtc-recorder

# Client WebSocket connections, proxied here by the pod's nginx via 10.0.2.2.
clientHost: 127.0.0.1

mcs-host: 127.0.0.1
mcs-address: 127.0.0.1

freeswitch:
  # Same network namespace, so stock ports on loopback and no userspace proxy.
  ip: 127.0.0.1
  sip_ip: 127.0.0.1
  port: 5066
  esl_ip: 127.0.0.1
  esl_port: 8021

log:
  # trace|debug|info|warn|error
  level: info
  stdout: true
  file: false

mediasoup:
  dedicatedMediaTypeWorkers:
    audio: auto
  workerBalancing:
    strategy: least-loaded

  worker:
    # The allocated range, not mediasoup's default. Shared by every worker.
    rtcMinPort: @@MEDIASOUP_MIN_PORT@@
    rtcMaxPort: @@MEDIASOUP_MAX_PORT@@

  plainRtp:
    listenIp:
      # The SFU<->FreeSWITCH leg never leaves the node.
      ip: "127.0.0.1"
      announcedIp: "127.0.0.1"
