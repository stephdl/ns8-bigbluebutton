defaultWelcomeMessage={{ .Env.WELCOME_MESSAGE }}
defaultWelcomeMessageFooter={{ .Env.WELCOME_FOOTER }}

{{ if isTrue .Env.ENABLE_RECORDING }}
disableRecordingDefault=false
{{ else }}
disableRecordingDefault=true
{{ end }}

bigbluebutton.web.serverURL=https://{{ .Env.DOMAIN }}

securitySalt={{ .Env.SHARED_SECRET }}

redisHost=redis

# Verbatim copy, one line changed: upstream swings this property to
# raw.githubusercontent.com under IGNORE_TLS_CERT_ERRORS, fetching the deck over
# the internet on every meeting create.
#
# Being a copy, a key added upstream is lost silently. Re-diff on every bump.
beans.presentationService.defaultUploadedPresentation=${bigbluebutton.web.serverURL}/default.pdf

# Greenlight hands bbb-web an https://DOMAIN/rails/active_storage/... URL for a
# room's own deck, and DOMAIN resolves to 127.0.0.1 inside the pod. Without this
# exemption PresRedirectValidator rejects it as a loopback address, and since the
# create call did declare a presentation, the meeting opens with no slide at all.
fetchUrlAllowedLocalHosts={{ .Env.DOMAIN }}

# What actually switches features off in 3.0. learningDashboardEnabled is dead: only
# this list is read, and the create API adds to it rather than replacing it.
disabledFeatures={{ .Env.DISABLED_FEATURES }}

# This timer dies with the JVM, so bin/bigbluebutton-periodic enforces retention
# too. 0 disables it, which is also what an unconfigured instance gets.
{{ if .Env.LEARNING_DASHBOARD_CLEANUP_MINUTES }}
learningDashboardCleanupDelayInMinutes={{ .Env.LEARNING_DASHBOARD_CLEANUP_MINUTES }}
{{ else }}
learningDashboardCleanupDelayInMinutes=0
{{ end }}

defaultNumDigitsForTelVoice=9
