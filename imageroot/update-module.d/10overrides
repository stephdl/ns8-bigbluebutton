#
# Re-render state/overrides/ so an existing instance picks up templates and
# generated files added since it was last configured.
#
# update-module does not run configure-module, and state/overrides/ is not
# restored from backup either -- it is regenerated on every configure. So an
# instance upgraded to a version that mounts a new override file would start
# containers whose bind mount has no source, and podman fails them.
#
# Runs after 05secrets, which the render reads, and before 20restart, so the
# services come back with the files already in place.
#

set -e
exec 1>&2 # Redirect any output to the journal

# Nothing to render before the first configure-module: the templates need the
# hostname and the allocated ports, and neither exists yet.
if ! grep -q '^TRAEFIK_HOST=' "${AGENT_STATE_DIR}/environment" 2>/dev/null; then
    echo "instance not configured yet, skipping the override refresh"
    exit 0
fi

exec "${AGENT_INSTALL_DIR}/actions/configure-module/30render_overrides"
