#
# Fill in secrets added to the module since this instance was installed.
# create-module never runs again, so without this an instance created before a
# secret existed would fail wherever that secret is first read.
#
# Runs before 30restart so the services come back with the file complete.
#

set -e
exec 1>&2 # Redirect any output to the journal

exec generate-secrets
